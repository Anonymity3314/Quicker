<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 自定义右键菜单中每一项样式 -->
    <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Height="{TemplateBinding Height}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 鼠标悬停或高亮时高亮背景 -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F3F3"/>
                        </Trigger>
                        <!-- 禁用时降低透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- 自定义右键菜单中分割线样式 -->
    <Style x:Key="CustomSeparatorStyle" TargetType="Separator">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid>
                        <Border Height="1" Background="#FFF0F0F0" Margin="0" HorizontalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 自定义滚动条右键菜单的整体样式，包含阴影和圆角 -->
    <Style x:Key="CustomContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Width" Value="160"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- 外层Grid用于叠加阴影和内容，Margin为菜单整体留出空间 -->
                    <Grid Margin="5">
                        <!-- 阴影层 -->
                        <Border Background="White" CornerRadius="3" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#44000000" BlurRadius="6" ShadowDepth="1" Direction="0"/>
                            </Border.Effect>
                        </Border>
                        <!-- 主体层 -->
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>