<UserControl
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Quicker.UserControls"
    x:Class="Quicker.UserControls.ColorPicker"
    mc:Ignorable="d"
   
    Background="White"
    d:DesignHeight="325"
    d:DesignWidth="345"
>
    <Grid>
        <Canvas x:Name="ColorCanvas" Margin="8,10,35,165">
            <Canvas.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Canvas.Background>

            <!-- 可拖动的圆形 -->
            <Border x:Name="ColorThumb" 
                    Width="16"
                    Height="16" 
                    Canvas.Left="{Binding X, Mode=TwoWay}" 
                    Canvas.Top="{Binding Y, Mode=TwoWay}"
                    Background="Transparent"
                    BorderBrush="White"
                    BorderThickness="3.5"
                    CornerRadius="8"/>
            <!--                    MouseLeftButtonDown="Circle_MouseDown"
                    MouseMove="Circle_MouseMove"
                    MouseLeftButtonUp="Circle_MouseUp"-->
        </Canvas>

        <!-- 颜色选择器滑块 -->
        <Slider x:Name="HueSlider" Value="{Binding H, Mode=TwoWay}" Minimum="0" Maximum="360" Style="{StaticResource ColorPickerSlider}" VerticalAlignment="Top" Margin="319,10,10,0" Height="174">
            <Slider.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF0000" />
                    <GradientStop Offset="0.1667" Color="#FFFF00" />
                    <GradientStop Offset="0.333" Color="#00FF00" />
                    <GradientStop Offset="0.500" Color="#00FFFF" />
                    <GradientStop Offset="0.667" Color="#0000FF" />
                    <GradientStop Offset="0.83" Color="#FF00FF" />
                    <GradientStop Offset="1.00" Color="#FF0000" />
                </LinearGradientBrush>
            </Slider.Background>
        </Slider>

        <StackPanel Margin="10,189,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="325">
            <!-- R 值滑块 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center"/>
                <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Grid.Column="1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="RedValue" Text="{Binding ElementName=RedSlider, Path=Value, Mode=TwoWay}" Grid.Column="2" Margin="55,0,-45,0" Width="40" TextAlignment="Right" TextChanged="Value_TextChanged"/>
            </Grid>
            <!-- G 值滑块 -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" VerticalAlignment="Center"/>
                <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Grid.Column="1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="GreenValue" Text="{Binding ElementName=GreenSlider, Path=Value, Mode=TwoWay}" Grid.Column="2" Margin="55,0,-45,0" Width="40" TextAlignment="Right" TextChanged="Value_TextChanged"/>
            </Grid>
            <!-- B 值滑块 -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" VerticalAlignment="Center"/>
                <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Grid.Column="1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="BlueValue" Text="{Binding ElementName=BlueSlider, Path=Value, Mode=TwoWay}" Grid.Column="2" Margin="55,0,-45,0" Width="40" TextAlignment="Right" TextChanged="Value_TextChanged"/>
            </Grid>
            <!-- A 值滑块 -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="A" VerticalAlignment="Center"/>
                <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" Grid.Column="1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="AlphaValue" Text="{Binding ElementName=AlphaSlider, Path=Value, Mode=TwoWay}" Grid.Column="2" Margin="55,0,-45,0" Width="40" TextAlignment="Right" TextChanged="Value_TextChanged"/>
            </Grid>
        </StackPanel>
        <TextBox x:Name="HexValue" Text="#FFD5D5D5" HorizontalAlignment="Left" Margin="151,165,0,0" Width="159" VerticalAlignment="Top" Height="19"/>
    </Grid>
</UserControl>