<UserControl
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Quicker.UserControls.AddWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.UserControls.AddWindow.OpenFile"
    mc:Ignorable="d" 
    
    Background="White"
    d:DesignHeight="289"
    d:DesignWidth="493"
    
    Unloaded="OpenFile_Unloaded"
>
    <Grid>
        <Label x:Name="LocationLabel" Content="路径/命令" Margin="93,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="63"/>
        <TextBox x:Name="LocationTextBox" Style="{StaticResource AddressTextBox}" Width="233" Height="25" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="161,15,0,0" TextChanged="LocationTextBox_TextChanged"/>
        <Label Content="窗口风格" Margin="96,52,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="58"/>
        <ComboBox x:Name="WindowStateComboBox" HorizontalAlignment="Left" Margin="161,52,0,0" VerticalAlignment="Top" Width="272" Height="26" Background="White">
            <ComboBoxItem Content="普通(Normal)" VerticalAlignment="Center"/>
            <ComboBoxItem Content="最小化(Minimized)" VerticalAlignment="Center"/>
            <ComboBoxItem Content="最大化(Maximized)" VerticalAlignment="Center"/>
        </ComboBox>
        <CheckBox x:Name="RunByMessager" Content="用管理员身份运行" HorizontalAlignment="Left" Margin="159,110,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="TryToOpenExitingWindow" Content="如果程序已在运行，则尝试激活已打开的窗口" HorizontalAlignment="Left" Margin="159,130,0,0" VerticalAlignment="Top"/>
        <Label Content="选项" HorizontalAlignment="Left" Margin="120,105,0,0" VerticalAlignment="Top"/>
        <Label Content="设置期望的窗口风格，是否有效依赖于具体的软件" HorizontalAlignment="Left" Margin="155,78,0,0" VerticalAlignment="Top" Foreground="#FF8C8C8C" Width="284"/>
        <Button Style="{StaticResource Select}" x:Name="SelectButton" Content="选择..." HorizontalAlignment="Left" Margin="393,15,0,0" VerticalAlignment="Top" Height="25" Width="40" Click="OpenContextMenu"/>
        <Popup x:Name="OpenFilePopup" PopupAnimation="Fade" Width="180" Height="112" PlacementTarget="{Binding ElementName=SelectButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
            <Grid>
                <Rectangle Fill="White" Margin="3,5">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="15" RenderingBias="Quality" ShadowDepth="1"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                    <StackPanel Background="{x:Null}" Margin="0,3">
                        <Button Style="{StaticResource MenuButton}" ToolTip="选择开始菜单中可以找到的程序" Click="ChooseApplications">
                            <Grid Width="174" Height="20">
                                <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource ImageStyle}"/>
                                <TextBlock Text="已安装的软件..." TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuButton}" ToolTip="打开文件或运行程序" Click="ChooseProcess">
                            <Grid Width="174" Height="20">
                                <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource ImageStyle}"/>
                                <TextBlock Text="文件..." TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuButton}" ToolTip="在资源管理器中打开Windows目录" Click="ChooseFolder">
                            <Grid Width="174" Height="20">
                                <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource ImageStyle}"/>
                                <TextBlock Text="文件夹..." TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuButton}" ToolTip="将剪切板中的文本作为文件打开或作为命令执行" Click="CopyLocation">
                            <Grid Width="174" Height="20">
                                <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource ImageStyle}"/>
                                <TextBlock Text="变量:剪贴板文本" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>