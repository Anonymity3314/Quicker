<UserControl
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Quicker.UserControls.AddWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.UserControls.AddWindow.OpenWebsite"
    mc:Ignorable="d" 
    
    Background="White"
    d:DesignHeight="289"
    d:DesignWidth="493"
    
    Unloaded="OpenWebsite_Unloaded"
    Loaded="OpenWebsite_Loaded"
>
    <Grid>
        <Label Content="网址" Margin="122,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="34"/>
        <TextBox x:Name="LocationTextBox" Style="{StaticResource AddressTextBox}" Width="231" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="161,15,0,0" TextChanged="LocationTextBox_TextChanged" Text="https://" SizeChanged="LocationTextBox_SizeChanged"/>
        <Button Style="{StaticResource Select}" x:Name="SelectButton" Content="···" HorizontalAlignment="Left" Margin="392,15,0,0" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=LocationTextBox}" Width="40" Click="OpenContextMenu" FontWeight="Bold" Foreground="#FFA9A6A6"/>
        <Popup x:Name="OpenWebsitePopup" PopupAnimation="Fade" Width="180" Height="35" PlacementTarget="{Binding ElementName=SelectButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
            <Grid>
                <Border Background="White" CornerRadius="3" Margin="3">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="6" RenderingBias="Quality" ShadowDepth="1"/>
                    </Border.Effect>
                </Border>
                <Border Background="White" CornerRadius="3" Margin="3">
                    <Button Style="{StaticResource MenuButton}" Click="CopyLocation">
                        <Grid Width="174" Height="20">
                            <Image Source="/Resources/Images/Quicker_Enabled.png" Style="{StaticResource SelectButtonImage}"/>
                            <TextBlock Text="插入剪切贴板文本" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Popup>
        <Grid x:Name="Grid1" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Height="249" Width="493">
            <Label Margin="116,35,0,0" Content="浏览器" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Button x:Name="GetWebsiteIconButton" Content="获取网站图标" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,5,0,0" VerticalAlignment="Top" Width="85" Height="25" Click="GetWebsiteIconButton_Click"/>
            <ComboBox x:Name="BrowserComboBox" Margin="167,35,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="138" Height="25" SelectedIndex="0" VerticalContentAlignment="Center" SelectionChanged="BrowserComboBox_SelectionChanged">
                <ComboBoxItem>
                    <TextBlock Text="(系统默认浏览器)" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="IE浏览器" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="Edge" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="Edge App模式" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="Edge InPrivate窗口" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="Chorme" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="Chrome App模式" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="Chrome 无痕窗口" Margin="5,0"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <TextBlock Text="自定义浏览器程序" Margin="5,0"/>
                </ComboBoxItem>
            </ComboBox>
            <Grid x:Name="UserControlGrid" Margin="0,65,0,0" Visibility="Collapsed">
                <Label Content="自定义浏览器" HorizontalAlignment="Left" Margin="80,4,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="BrowserLocation" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" Margin="167,4,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="312"/>
                <Label Content="使用自定义浏览器时，指定该浏览器的完整路径" HorizontalAlignment="Left" Margin="167,29,0,0" VerticalAlignment="Top" FontSize="11"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>