<UserControl
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Quicker.UserControls.AddWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.UserControls.AddWindow.OpenWebsite"
    mc:Ignorable="d" 
    
    Background="White"
    d:DesignHeight="289"
    d:DesignWidth="493"
>
    <Grid>
        <Label Content="网址" Margin="122,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="34"/>
        <TextBox x:Name="LocationTextBox" Style="{StaticResource AddressTextBox}" Width="233" Height="25" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="161,15,0,0" TextChanged="LocationTextBox_TextChanged" Text="https://"/>
        <Button Style="{StaticResource Select}" x:Name="SelectButton" Content="···" HorizontalAlignment="Left" Margin="393,15,0,0" VerticalAlignment="Top" Height="25" Width="39" Click="OpenContextMenu" FontSize="16" FontWeight="Bold"/>
        <Popup x:Name="OpenWebsitePopup" PopupAnimation="Fade" Width="180" Height="35" PlacementTarget="{Binding ElementName=SelectButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
            <Grid>
                <Rectangle Fill="White" Margin="3,5">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="15" RenderingBias="Quality" ShadowDepth="1"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                    <Button Style="{StaticResource MenuButton}" Click="CopyLocation">
                        <Grid Width="174" Height="20">
                            <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource ImageStyle}"/>
                            <TextBlock Text="插入剪切贴板文本" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Popup>
        <Button x:Name="GetWebsiteIconButton" Content="获取网站图标" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="161,45,0,0" VerticalAlignment="Top" Width="85" Height="25" Click="GetWebsiteIconButton_Click"/>
    </Grid>
</UserControl>