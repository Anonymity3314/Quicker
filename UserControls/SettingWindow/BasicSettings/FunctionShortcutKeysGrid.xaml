<UserControl
    x:Class="Quicker.UserControls.SettingWindow.BasicSettings.FunctionShortcutKeysGrid"
    xmlns:local="clr-namespace:Quicker.UserControls.SettingWindow.BasicSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"

    d:DesignHeight="870"
    d:DesignWidth="982"
>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="953*"/>
        </Grid.ColumnDefinitions>
        <!-- 功能快捷键 -->
        <Button Content="功能快捷键" Style="{StaticResource Button3}" Margin="1,14,0,0" Width="102" Grid.Column="1" Height="30" BorderThickness="0,0,0,2"/>
        <!-- 主要 -->
        <GroupBox Header="主要" Style="{StaticResource SettingGroupBox}" Margin="15,61,0,0" Grid.ColumnSpan="2">
            <Grid>
                <Label Content="停止运行中的动作：" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <Label Content="暂停/恢复Quicker：" HorizontalAlignment="Left" Margin="10,43,0,0" VerticalAlignment="Top"/>
                <Label Content="打开搜索框：" HorizontalAlignment="Left" Margin="10,76,0,0" VerticalAlignment="Top"/>
            </Grid>
        </GroupBox>
        <!-- 次要 -->
        <GroupBox Header="次要" Style="{StaticResource SettingGroupBox}" Margin="15,233,0,0" Grid.ColumnSpan="2">
            <Grid>
                <Label Content="打开设置窗口：" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <Label Content="打开场景与动作管理窗口：" HorizontalAlignment="Left" Margin="10,43,0,0" VerticalAlignment="Top"/>
                <Label Content="运行最后使用的动作：" HorizontalAlignment="Left" Margin="10,76,0,0" VerticalAlignment="Top"/>
                <Label Content="打开仪表盘窗口：" HorizontalAlignment="Left" Margin="10,109,0,0" VerticalAlignment="Top"/>
                <Label Content="关闭所有浮动按钮：" HorizontalAlignment="Left" Margin="10,142,0,0" VerticalAlignment="Top"/>
                <Label Content="重新加载键鼠挂钩：" HorizontalAlignment="Left" Margin="10,175,0,0" VerticalAlignment="Top"/>
                <Label Content="打开/关闭文本悬浮窗：" HorizontalAlignment="Left" Margin="10,208,0,0" VerticalAlignment="Top"/>
                <Label Content="启用APP语音输入：" HorizontalAlignment="Left" Margin="10,241,0,0" VerticalAlignment="Top"/>
            </Grid>
        </GroupBox>
        <!-- 选项 -->
        <GroupBox Header="选项" Style="{StaticResource SettingGroupBox}" Margin="15,565,0,0" Grid.ColumnSpan="2">
            <Grid>
                <Label Content="暂停Quicker时保留快捷键：" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <ComboBox HorizontalAlignment="Left" Margin="203,12,0,0" VerticalAlignment="Top" Width="212" Height="24">
                    <ComboBoxItem Content="保留所有快捷键"/>
                    <ComboBoxItem Content="仅保留 暂停/恢复 快捷键"/>
                    <ComboBoxItem Content="清除所有快捷键"/>
                </ComboBox>
            </Grid>
        </GroupBox>
        <!-- 说明 -->
        <Label Grid.Column="1" Content="设置用于触发Quicker功能的全局快捷键。" HorizontalAlignment="Right" Margin="0,56,65,0" VerticalAlignment="Top" Foreground="Gray" FontSize="13"/>
        <Label Grid.Column="1" Content="即使在黑名单应用下，快捷键也生效。" HorizontalAlignment="Right" Margin="0,73,87,0" VerticalAlignment="Top" Foreground="Gray" FontSize="13"/>
    </Grid>
</UserControl>