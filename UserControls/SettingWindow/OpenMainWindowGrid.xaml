<UserControl
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.UserControls.OpenMainWindowGrid"
    xmlns:local="clr-namespace:Quicker.UserControls"
    mc:Ignorable="d"
    
    Background="White"
    d:DesignHeight="870"
    d:DesignWidth="982"
    
    Unloaded="OpenMainWindowGrid_Unloaded"
>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="953*"/>
        </Grid.ColumnDefinitions>
        <!-- 基础设置-弹出面板-弹出面板 -->
        <Button x:Name="OpenMainWindowButton" Content="弹出面板" ToolTip="面板窗口的触发方式" Style="{StaticResource Button3}" Margin="1,14,0,0" Width="74" Click="OpenMainWindowButton_Click" Grid.Column="1" Height="30" BorderThickness="0,0,0,2"/>
        <Grid x:Name="OpenMainWindowButtonGrid" Margin="10,43,0,0" Visibility="Visible" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186*"/>
                <ColumnDefinition Width="133*"/>
            </Grid.ColumnDefinitions>
            <Label Content="鼠标方式" HorizontalAlignment="Left" Margin="10,33,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" Height="30" Width="74"/>
            <StackPanel Margin="10,68,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="142" Width="110">
                <CheckBox x:Name="OpenMainWindowByMiddleMouseClickCheckBox" Content="按下中键" ToolTip="按下鼠标中键" FontSize="14" Click="CheckBox_Click"/>
                <CheckBox x:Name="OpenMainWindowByX1MouseClickCheckBox" Content="按下X1键" ToolTip="需鼠标支持，通常为侧键" FontSize="14" Click="CheckBox_Click"/>
                <CheckBox x:Name="OpenMainWindowByX2MouseClickCheckBox" Content="按下X2键" ToolTip="需鼠标支持，通常为侧键" FontSize="14" Click="CheckBox_Click"/>
                <CheckBox x:Name="OpenMainWindowByCtrl_MiddleMouseClickCheckBox" Content="Ctrl+中键单击" FontSize="14" Click="CheckBox_Click"/>
                <CheckBox x:Name="OpenMainWindowByCtrl_RightMouseClickCheckBox" Content="Ctrl+右键单击" FontSize="14" Click="CheckBox_Click"/>
                <CheckBox x:Name="OpenMainWindowByMiddleMouseClickLongerCheckBox" Content="长按中键" FontSize="14" Click="CheckBox_Click"/>
                <CheckBox x:Name="OpenMainWindowByRightMouseClickLongerCheckBox" Content="长按右键" FontSize="14" Click="CheckBox_Click"/>
                <CheckBox x:Name="OpenMainWindowByRightMouseClick_MoveCheckBox" Content="按右键移动" FontSize="14" Click="CheckBox_Click"/>
            </StackPanel>
            <!--<GroupBox Header="鼠标弹出选项" Margin="10,213,621,509">
                        <CheckBox Content="在按钮上松开后执行动作" HorizontalAlignment="Left" Margin="10,0,0,0" Height="17">
                            <CheckBox.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="激活面板后不松开鼠标，移动到按钮上松开，此时执行鼠标位置的动作。"/>
                                    <TextBlock Text="单击中键\长按右键\按右键移动等方式下有效。"/>
                                </StackPanel>
                            </CheckBox.ToolTip>
                        </CheckBox>
                    </GroupBox>-->
            <Label Content="键盘方式" HorizontalAlignment="Left" Margin="10,240,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize=" 16" Height="30" Width="74"/>
            <CheckBox x:Name="OpenMainWindowByCtrlCheckBox" Content="单击Ctrl键" Margin="10,275,0,0" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Height="15" Width="76"/>
            <!--<TextBox x:Name="DIY_ShortcutKeys" ToolTip="请按键" HorizontalAlignment="Left" Margin="10,373,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="251" KeyDown="DIY_ShortcutKeys_KeyDown" PreviewTextInput="DIY_ShortcutKeys_PreviewTextInput" PreviewKeyUp="DIY_ShortcutKeys_PreviewKeyUp" TextAlignment="Center"/>-->
            <!--<Button HorizontalAlignment="Left" Margin="240,373,0,0" VerticalAlignment="Top" Width="21" Height="17" Click="ClearDIY_ShortcutKeys"/>-->
            <GroupBox Header="键盘弹出选项" Margin="10,325,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="57" Width="202">
                <Grid>
                    <!--<CheckBox Content="自动激活鼠标位置窗口" HorizontalAlignment="Left" Margin="10,52,0,10" Height="17"/>-->
                    <ComboBox x:Name="WindowStartupLocationComboBox" HorizontalAlignment="Left" Margin="70,14,0,0" VerticalAlignment="Top" Width="120" IsReadOnly="True" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem>
                            <TextBlock Text="系统默认" Margin="5,0"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="跟随鼠标" Margin="5,0"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="屏幕中心" Margin="5,0"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="当前窗口中心" Margin="5,0"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="上次弹出位置" Margin="5,0"/>
                        </ComboBoxItem>
                    </ComboBox>
                    <Label Content="弹出位置：" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                </Grid>
            </GroupBox>
            <Button x:Name="TestButton" Content="按键测试区" ToolTip="在此处点击鼠标按键以显示按键名称。" Style="{StaticResource WhiteButton}" HorizontalAlignment="Stretch" Margin="0,35,17,0" VerticalAlignment="Top" Width="NaN" Height="83" PreviewMouseDown="TestMouseKey" FontSize="16" Grid.Column="1"/>
        </Grid>

        <!-- 基础设置-弹出面板-动作触发按键 -->
        <Button x:Name="DoActionKeyboardButton" Content="动作触发按键" ToolTip="键盘方式弹出后，使用按键触发动作" Style="{StaticResource Button3}" Margin="75,13,0,0" Width="116" Click="DoActionKeyboard_Click" BorderThickness="0" Grid.Column="1" Visibility="Collapsed"/>
        <Grid x:Name="DoActionKeyboardButtonGrid" Margin="10,43,0,0" Visibility="Hidden" Grid.ColumnSpan="2">

        </Grid>
    </Grid>
</UserControl>
