<UserControl
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Quicker.UserControls"
    x:Class="Quicker.UserControls.AboutQuickerGrid"
    mc:Ignorable="d"

    Background="White"
    d:DesignHeight="870"
    d:DesignWidth="982"
    
    Unloaded="AboutQuickerGrid_Unloaded"
>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="952*"/>
        </Grid.ColumnDefinitions>
        <!-- 基础设置-关于Quicker-关于Quicker -->
        <Button x:Name="AboutQuickerButton" Content="关于Quicker" ToolTip="基础信息" Style="{StaticResource Button3}" Margin="1,14,0,0" Width="99" Click="AboutQuickerButton_Click" Grid.Column="1" BorderThickness="0,0,0,2"/>
        <Grid x:Name="AboutQuickerButtonGrid" Margin="10,43,0,0" Visibility="Visible" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="647*"/>
                <ColumnDefinition Width="300*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Quicker" HorizontalAlignment="Left" Margin="57,16,0,0" VerticalAlignment="Top" FontSize="24" FontWeight="Bold"/>
            <Image HorizontalAlignment="Left" Height="48" Margin="4,12,0,0" VerticalAlignment="Top" Width="48" Source="/Resources/Images/Quicker1.png"/>
            <Label x:Name="VersionLabel" Content="版本：" HorizontalAlignment="Left" Margin="4,65,0,0" VerticalAlignment="Top" FontSize="16"/>
            <Label Content="特别感谢" HorizontalAlignment="Left" Margin="4,127,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
            <Label Content="特别感谢给予Quicker各种支持的朋友们。" HorizontalAlignment="Left" Margin="10,157,0,0" VerticalAlignment="Top" FontSize="14"/>
            <!--<Label Content="正是因为你们，Quicker才可以存在并不断进步！" HorizontalAlignment="Left" Margin="10,180,0,0" VerticalAlignment="Top" FontSize="14"/>-->
            <TextBlock x:Name="UpdateHistory" Text="更新历史" HorizontalAlignment="Left" Margin="96,70,0,0" VerticalAlignment="Top" Foreground="#FF326CF3" FontSize="16" Cursor="Hand" MouseLeftButtonDown="OpenUpdateHistory">
                <TextBlock.ToolTip>
                    <ToolTip Content="点击查看" FontSize="12" Foreground="Black"/>
                </TextBlock.ToolTip>
            </TextBlock>
            <Label Content="By @Anonymity" HorizontalAlignment="Left" Margin="4,97,0,0" VerticalAlignment="Top" FontSize="16"/>
            <Label HorizontalAlignment="Left" Margin="0,49,0,0" VerticalAlignment="Top" Content="图标资源" Foreground="Black" FontSize="16" Grid.Column="1"/>
            <TextBlock x:Name="www_iconfont_cn" ToolTip="点击前往" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top" Text="www.iconfont.cn" MouseLeftButtonDown="www_iconfont_cn_MouseLeftButtonDown" Foreground="#FF326CF3" FontSize="14" Cursor="Hand" Grid.Column="1"/>
            <TextBlock x:Name="fontawesome_com" ToolTip="点击前往" HorizontalAlignment="Left" Margin="10,126,0,0" VerticalAlignment="Top" Text="fontawesome.com" MouseLeftButtonDown="fontawesome_com_MouseLeftButtonDown" Foreground="#FF326CF3" FontSize="14" Cursor="Hand" Grid.Column="1"/>
            <TextBlock x:Name="icons8_com" ToolTip="点击前往" HorizontalAlignment="Left" Margin="10,103,0,0" VerticalAlignment="Top" Text="icons8.com" MouseLeftButtonDown="icons8_com_MouseLeftButtonDown" Foreground="#FF326CF3" FontSize="14" Cursor="Hand" Grid.Column="1"/>
            <Label HorizontalAlignment="Left" Margin="0,186,0,0" VerticalAlignment="Top" Content="支持" Foreground="Black" FontSize="16" Grid.Column="1"/>
            <TextBlock x:Name="FeedBack" ToolTip="点击前往" HorizontalAlignment="Left" Margin="10,221,0,0" VerticalAlignment="Top" Text="BUG反馈、需求" MouseLeftButtonDown="FeedBack_MouseLeftButtonDown" Foreground="#FF326CF3" FontSize="14" Cursor="Hand" Grid.Column="1"/>
            <TextBlock x:Name="icon11_community_github_io" ToolTip="点击前往" HorizontalAlignment="Left" Margin="10,149,0,0" VerticalAlignment="Top" Text="icon11-community.github.io" MouseLeftButtonDown="icon11_community_github_io_MouseLeftButtonDown" Foreground="#FF326CF3" FontSize="14" Cursor="Hand" Grid.Column="1"/>

            <Label Content="数据文件夹" HorizontalAlignment="Left" Margin="0,383,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
            <Label Content="根文件夹：" HorizontalAlignment="Left" Margin="18,413,0,0" VerticalAlignment="Top" FontSize="14"/>
            <TextBlock x:Name="RootFolderPath" HorizontalAlignment="Left" Margin="23,443,0,0" TextWrapping="Wrap" Text="C:\Users\LENOVO\AppData\Roaming\Anonymity\Quicker" VerticalAlignment="Top" Foreground="#FF326CF3" Cursor="Hand" MouseDown="RootFolderPath_MouseDown"/>
            <Label Content="数据库文件夹：" HorizontalAlignment="Left" Margin="18,463,0,0" VerticalAlignment="Top" FontSize="14"/>
            <TextBlock x:Name="DatabaseFolderPath" HorizontalAlignment="Left" Margin="23,491,0,0" TextWrapping="Wrap" Text="C:\Users\LENOVO\AppData\Roaming\Anonymity\Quicker\Database" VerticalAlignment="Top" Foreground="#FF326CF3" Cursor="Hand" MouseDown="DatabaseFolderPath_MouseDown"/>
            <Label Content="图标文件夹：" HorizontalAlignment="Left" Margin="18,511,0,0" VerticalAlignment="Top" FontSize="14"/>
            <TextBlock x:Name="LocalIconsFolderPath" HorizontalAlignment="Left" Margin="23,539,0,0" TextWrapping="Wrap" Text="C:\Users\LENOVO\AppData\Roaming\Anonymity\Quicker\LocalIcons" VerticalAlignment="Top" Foreground="#FF326CF3" Cursor="Hand" MouseDown="LocalIconsFolderPath_MouseDown"/>

            <Label Content="备份数据" HorizontalAlignment="Left" Margin="0,574,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
            <Button x:Name="BackupDataButton" Style="{StaticResource WhiteButton}" Content="备份全部数据" HorizontalAlignment="Left" Margin="14,609,0,0" VerticalAlignment="Top" Click="BackupDataButton_Click" Width="88"/>
            <Label Content="仅作为备份用途，不支持导入。" HorizontalAlignment="Left" Margin="14,633,0,0" VerticalAlignment="Top" FontSize="10" Foreground="#FFB4B4B4"/>

            <Label Content="临时文件" HorizontalAlignment="Left" Margin="0,661,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>
            <Label Content="大小：" HorizontalAlignment="Left" Margin="18,696,0,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="TempSize" HorizontalAlignment="Left" Margin="58,701,0,0" TextWrapping="Wrap" Text="计算中...·" VerticalAlignment="Top"/>
            <Button x:Name="CleanTempDataButton" Content="清理" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="23,726,0,0" VerticalAlignment="Top" Width="61" Click="CleanTempDataButton_Click"/>
        </Grid>

        <!-- 基础设置-关于Quicker-隐私声明 -->
        <Button x:Name="Privacy_StatementButton" Content="隐私声明" ToolTip="隐私声明" Style="{StaticResource Button3}" Margin="100,14,0,0" Width="74" Click="Privacy_StatementButton_Click" BorderThickness="0" Grid.Column="1"/>
        <Grid x:Name="Privacy_StatementButtonGrid" Margin="10,43,317,0" Visibility="Hidden" Grid.ColumnSpan="2">
            <Label Content="键盘钩子(HOOK):" HorizontalAlignment="Left" Margin="16,43,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>
            <Label Content="隐私声明" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="18"/>
            <Label Content="本软件会使用全局键盘钩子(HOOK)判断按键状态，实现激活面板、扩展热键和文本指令等功能。&#xD;&#xA;安全软件可能会因此弹出安全提示。&#xD;&#xA;本软件不会监听和记录您的普通按键输入，也不会将这些输入内容发送到网络，请放心使用。" HorizontalAlignment="Left" Margin="27,73,0,0" VerticalAlignment="Top" FontSize="14"/>
        </Grid>
    </Grid>
</UserControl>