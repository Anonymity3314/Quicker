<UserControl
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Quicker.UserControls"
    x:Class="Quicker.UserControls.AppearanceGrid"
    mc:Ignorable="d"

    Background="White"
    d:DesignHeight="870"
    d:DesignWidth="982"
    
    Unloaded="AppearanceGrid_Unloaded"
>
    <UserControl.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" ShadowDepth="3" Direction="315" Color="Black" Opacity="0.3" BlurRadius="5"/>
    </UserControl.Resources>
    
    <!-- d:DesignHeight="870" -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="952*"/>
        </Grid.ColumnDefinitions>
        <!-- 基础设置-外观-面板窗口 -->
        <Button x:Name="AppearanceButton"  Content="面板窗口" ToolTip="外观设置" Style="{StaticResource Button3}" Margin="1,14,0,0" Width="82" Grid.Column="1" Height="30" BorderThickness="0,0,0,2"/>
        <Grid x:Name="AppearanceButtonGrid" Margin="10,43,0,0" Visibility="Visible" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186*"/>
                <ColumnDefinition Width="133*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="SettingGrid" Grid.Column="0" MouseEnter="SettingGrid_MouseEnter" MouseLeave="SettingGrid_MouseLeave" Margin="0,0,0,10">
                <ScrollViewer x:Name="ScrollViewer" VerticalScrollBarVisibility="Hidden" ScrollChanged="ScrollViewer_ScrollChanged">
                    <Grid>
                        <Button Content="默认设置" Style="{StaticResource Button3}" Margin="7,10,0,0" Foreground="#FF0087FC" Width="70"/>
                        <Rectangle Fill="#FFD5D5D5" VerticalAlignment="Top" Height="1" Margin="7,40,10,0"/>
                        
                        <!-- 尺寸 -->
                        <Label Content="尺寸" Margin="10,50,494,822" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <!-- 尺寸-按钮大小 -->
                        <Label Content="按钮大小：" Margin="10,90,472,702" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Slider x:Name="ButtonSizeSlider" HorizontalAlignment="Left" Margin="121,90,0,0" VerticalAlignment="Top" Width="120" Height="35" Minimum="40" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBox x:Name="ButtonSizeTextBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" Margin="261,99,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="120" Text="{Binding ElementName=ButtonSizeSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                        <!-- 尺寸-按钮间隙 -->
                        <Label Content="按钮间隙：" Margin="10,125,472,667" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Slider x:Name="ButtonGapSlider" HorizontalAlignment="Left" Margin="121,125,0,0" VerticalAlignment="Top" Width="120" Height="35" Minimum="-0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBox x:Name="ButtonGapTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="261,134,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="120" Text="{Binding ElementName=ButtonGapSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                        <!-- 尺寸-边框宽度 -->
                        <Label Content="边框宽度：" Margin="10,165,472,627" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Slider x:Name="BorderWidthSlider" HorizontalAlignment="Left" Margin="121,165,0,0" VerticalAlignment="Top" Width="120" Height="35" Minimum="0" Maximum="30" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBox x:Name="BorderWidthTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="261,169,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="120" Text="{Binding ElementName=BorderWidthSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                        <!-- 尺寸-按钮圆角 -->
                        <Label Content="按钮圆角：" Margin="10,205,472,587" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Slider x:Name="ButtonCornerRadiusSlider" HorizontalAlignment="Left" Margin="121,205,0,0" VerticalAlignment="Top" Width="120" Height="35" Minimum="0" Maximum="40" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBox x:Name="ButtonCornerRadiusTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="261,205,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="120" Text="{Binding ElementName=ButtonCornerRadiusSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>

                        <!-- 颜色 -->
                        <Label Content="颜色" Margin="10,240,494,631" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <!-- 颜色-背景 -->
                        <Label Content="背景：" Margin="10,276,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="BackgroundColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,279,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="BackgroundColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-工具栏 -->
                        <Label Content="工具栏：" Margin="10,302,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="ToolbarColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,305,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="ToolbarColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-工具栏图标 -->
                        <Label Content="工具栏图标：" Margin="10,328,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Button x:Name="ToolbarIconColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,331,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="ToolbarIconColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-动作按钮 -->
                        <Label Content="动作按钮：" Margin="10,354,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="ActionButtonColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,357,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="ActionButtonColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-动作按钮鼠标悬浮 -->
                        <Label Content="动作按钮鼠标悬浮：" Margin="10,380,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="ActionButtonMouseOverColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,383,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="ActionButtonMouseOverColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-空白按钮 -->
                        <Label Content="空白按钮：" Margin="10,406,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="BlankButtonColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,409,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="BlankButtonColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-空白按钮鼠标悬浮 -->
                        <Label Content="空白按钮鼠标悬浮：" Margin="10,432,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="BlankButtonMouseOverColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,435,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="BlankButtonMouseOverColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-按钮文字 -->
                        <Label Content="按钮文字：" Margin="10,458,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="ButtonTextColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,461,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="ButtonTextColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-动作矢量图标色 -->
                        <Label Content="动作矢量图标色：" Margin="10,484,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="ActionIconColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,487,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="ActionIconColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-触发键文字颜色 -->
                        <Label Content="触发键文字颜色：" Margin="10,510,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Button x:Name="TriggerKeyTextColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,513,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="TriggerKeyTextColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>
                        <!-- 颜色-其他位置矢量图标色 -->
                        <Label Content="其他位置矢量图标色：" Margin="10,536,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" Width="152"/>
                        <Button x:Name="OtherIconColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="167,539,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                            <Rectangle Width="100" Height="16">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="OtherIconColorBrush" Color="#FFFFFFFF"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Button>

                        <!-- 字体 -->
                        <Label Content="字体" Margin="15,569,0,0" FontWeight="Bold" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <!-- 字体-字体1 -->
                        <Label Content="字体1：" Margin="10,604,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="FontSizeComboBox1" HorizontalAlignment="Left" Margin="107,607,0,0" VerticalAlignment="Top" Width="120"/>
                        <!-- 字体-字体2 -->
                        <Label Content="字体2：" Margin="10,644,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="FontSizeComboBox2" HorizontalAlignment="Left" Margin="107,647,0,0" VerticalAlignment="Top" Width="120"/>
                        <!-- 字体-字体大小 -->
                        <Label Content="字体大小：" Margin="10,684,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Slider x:Name="FontSizeSlider" HorizontalAlignment="Left" Margin="110,684,0,0" VerticalAlignment="Top" Width="120" Height="35"/>
                        <TextBox x:Name="FontSizeTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="261,689,0,0" VerticalAlignment="Top" Width="120"/>
                        <!-- 字体-字体粗细 -->
                        <Label Content="字体粗细：" Margin="10,724,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <TextBox x:Name="FontWeightTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="110,729,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>

                        <!-- 背景图片 -->
                        <Label Content="背景图片" Margin="15,757,0,0" FontWeight="Bold" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <!-- 背景图片-路径 -->
                        <Label Content="路径：" Margin="10,792,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <TextBox x:Name="BackgroundImagePathTextBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" Margin="110,797,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176"/>
                        <Button x:Name="BackgroundImagePathButton" Content="选择..." Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="291,795,0,0" VerticalAlignment="Top" Width="43"/>
                        <!-- 背景图片-不透明度 -->
                        <Label Content="不透明度：" Margin="10,825,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <Slider x:Name="BackgroundImageOpacitySlider" HorizontalAlignment="Left" Margin="107,825,0,0" VerticalAlignment="Top" Width="120" Height="36" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBox x:Name="BackgroundImageOpacityTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="261,830,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Text="{Binding ElementName=BackgroundImageOpacitySlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>

                        <!-- 模糊与圆角 -->
                        <Label Content="模糊与圆角" Margin="15,858,0,0" FontWeight="Bold" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <!-- 模糊与圆角-模糊模式 -->
                        <Label Content="模糊模式：" Margin="10,893,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="BlurComboBox" HorizontalAlignment="Left" Margin="138,892,0,0" VerticalAlignment="Top" Width="120">
                            <ComboBoxItem Content="无"/>
                            <ComboBoxItem Content="毛玻璃"/>
                            <ComboBoxItem Content="无（去除窗口阴影）"/>
                        </ComboBox>
                        <!-- 模糊与圆角-Win11圆角模式 -->
                        <Label Content="Win11圆角模式：" Margin="10,926,0,0" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="Win11CornerRadiusComboBox" HorizontalAlignment="Left" Margin="138,929,0,0" VerticalAlignment="Top" Width="120">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="无"/>
                            <ComboBoxItem Content="圆角"/>
                            <ComboBoxItem Content="小圆角"/>
                        </ComboBox>

                        <!-- 选项 -->
                        <Label Content="选项" Margin="15,954,0,0" FontWeight="Bold" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <CheckBox x:Name="AutoHideTitleBarCheckBox" Content="自动缩小动作名称文字" HorizontalAlignment="Left" Margin="31,994,0,0" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14"/>
                        <CheckBox x:Name="ShowActionButtonMouseOverCheckBox" Content="鼠标悬浮在动作按钮上时，放大显示按钮" HorizontalAlignment="Left" Margin="31,1014,0,0" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14"/>
                        <CheckBox x:Name="HideActionNameAfterIconCheckBox" Content="设置动作图标后隐藏动作名称" HorizontalAlignment="Left" Margin="31,1034,0,0" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14"/>
                        <CheckBox x:Name="ShowActionIconShadowCheckBox" Content="动作图标显示阴影" HorizontalAlignment="Left" Margin="31,1054,0,0" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14"/>
                    </Grid>
                </ScrollViewer>
                <ScrollBar x:Name="AppearanceScrollBar" Visibility="Collapsed" HorizontalAlignment="Right" Width="18" ValueChanged="AppearanceScrollBar_ValueChanged" Margin="0,20,0,0"/>
            </Grid>
        </Grid>

        <!-- 添加颜色选择器Popup -->
        <Popup x:Name="ColorPickerPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=BackgroundColorButton}" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Effect="{StaticResource DropShadowEffect}">
                <local:ColorPicker x:Name="PopupColorPicker" Width="245" Height="280" SelectedColorChanged="PopupColorPicker_SelectedColorChanged"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>