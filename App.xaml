<Application
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="Windows/Menus/StartupWindow.xaml"
    xmlns:local="clr-namespace:Quicker"
    x:Class="Quicker.App"

    ShutdownMode="OnMainWindowClose"
>
    <Application.Resources>
        <ResourceDictionary>
            <!-- 定义TextBox右键菜单 -->
            <ContextMenu x:Key="TextBoxCustomContextMenu" Style="{StaticResource CustomContextMenuStyle}">
                <MenuItem Header="剪切" Command="ApplicationCommands.Cut" Style="{StaticResource CustomMenuItemStyle}"/>
                <MenuItem Header="复制" Command="ApplicationCommands.Copy" Style="{StaticResource CustomMenuItemStyle}"/>
                <MenuItem Header="粘贴" Command="ApplicationCommands.Paste" Style="{StaticResource CustomMenuItemStyle}"/>
                <Separator Style="{StaticResource CustomSeparatorStyle}"/>
                <MenuItem Header="选择所有" Command="ApplicationCommands.SelectAll" Style="{StaticResource CustomMenuItemStyle}"/>
            </ContextMenu>

            <!-- 字体资源 -->
            <FontFamily x:Key="GlobalFontFamily">微软雅黑</FontFamily>
            <!-- 全局默认控件字体样式 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="ContextMenu" Value="{DynamicResource TextBoxCustomContextMenu}"/>
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <!-- 合并资源词典必须放最后 -->
            <ResourceDictionary.MergedDictionaries>
                <!-- 右键菜单样式 -->
                <ResourceDictionary Source="Resources/Styles/CustomContextMenuStyle.xaml"/>
                <!-- 文本块样式 -->
                <ResourceDictionary Source="Resources/Styles/TextBlockStyles.xaml"/>
                <!-- 滚动条样式 -->
                <ResourceDictionary Source="Resources/Styles/ScrollBarStyle.xaml"/>
                <!-- 复选框样式 -->
                <ResourceDictionary Source="Resources/Styles/CheckBoxStyle.xaml"/>
                <!-- 输入框样式 -->
                <ResourceDictionary Source="Resources/Styles/TextBoxStyles.xaml"/>
                <!-- 下拉框样式 -->
                <ResourceDictionary Source="Resources/Styles/ComboBoxStyle.xaml"/>
                <!-- 画布样式 -->
                <ResourceDictionary Source="Resources/Styles/CanvasStyles.xaml"/>
                <!-- 提示框样式 -->
                <ResourceDictionary Source="Resources/Styles/TooltipStyle.xaml"/>
                <!-- 按钮样式 -->
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml"/>
                <!-- 标签样式 -->
                <ResourceDictionary Source="Resources/Styles/SliderStyle.xaml"/>
                <!-- 图片样式 -->
                <ResourceDictionary Source="Resources/Styles/ImageStyles.xaml"/>
                <!-- 网格样式 -->
                <ResourceDictionary Source="Resources/Styles/GridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>