<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Quicker"
    x:Class="Quicker.AddWindow"
    mc:Ignorable="d"

    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    Topmost="True"
    Height="450"
    Width="700"
    
    MouseDown="AddWindow_MouseDown"
    Loaded="AddWindow_Loaded"
    KeyDown="SaveAction"
>
    <Window.Resources>
        <!-- 菜单按钮上的图像样式 -->
        <Style x:Key="ImageStyle" TargetType="Image">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="20"/>
        </Style>
        <!-- “选择图片”的按钮样式 -->
        <Style x:Key="ImageButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF3F3F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Label Content="动作类型" HorizontalAlignment="Left" Margin="98,40,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="ChoiceComboBox" HorizontalAlignment="Left" Margin="162,40,0,0" VerticalAlignment="Top" Width="270" SelectedIndex="0" BorderBrush="#FFFBFBFB" Height="26" Background="White" SelectionChanged="ChoiceComboBox_SelectionChanged">
            <ComboBoxItem VerticalAlignment="Center">
                <Grid>
                    <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource ImageStyle}"/>
                    <TextBlock Text="运行程序或打开文件" Margin="25,0" VerticalAlignment="Center"/>
                </Grid>
            </ComboBoxItem>
            <ComboBoxItem VerticalAlignment="Center">
                <Grid>
                    <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource ImageStyle}"/>
                    <TextBlock Text="打开网址" Margin="25,0" VerticalAlignment="Center"/>
                </Grid>
            </ComboBoxItem>
        </ComboBox>
        <Button x:Name="SaveButton" Style="{StaticResource BlueButton}" Content="保存(S)" HorizontalAlignment="Left" Margin="256,374,0,0" VerticalAlignment="Top" BorderBrush="{x:Null}" Width="81" Height="30" Click="SaveAction" IsEnabled="False"/>
        <Button Style="{StaticResource WhiteButton}" Content="取消(C)" HorizontalAlignment="Left" Margin="348,374,0,0" VerticalAlignment="Top" Click="CloseAddWindow" Height="30" Width="81"/>
        <Button Style="{StaticResource ImageButton}"  HorizontalAlignment="Left" Margin="577,113,0,0" VerticalAlignment="Top" Click="ManageLocalIcons"/>
        <Rectangle HorizontalAlignment="Center" Height="1" Margin="0,0,0,79" Stroke="LightGray" VerticalAlignment="Bottom" Width="648"/>
        <Rectangle HorizontalAlignment="Left" Margin="493,10,0,85" Stroke="LightGray" Width="1"/>
        <Button Style="{StaticResource ImageButton}" ToolTip="去除图标" HorizontalAlignment="Left" Margin="601,113,0,0" VerticalAlignment="Top" Click="DeleteImage">
            <Image Source="/Resources/Images/Icons/DeleteImage.ico"/>
        </Button>
        <TextBox x:Name="TitleTextBox" Style="{StaticResource RoundedTextBox}" Width="138" Height="25"  Margin="520,172,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextChanged="UpdateTitle"/>
        <TextBox x:Name="UsageTextBox" Style="{StaticResource RoundedTextBox}" Width="138" Height="25" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="520,232,0,0" TextChanged="UsageTextBox_TextChanged"/>
        <Label Content="标题" HorizontalAlignment="Left" Margin="515,142,0,0" VerticalAlignment="Top"/>
        <Label Content="功能/用途说明" HorizontalAlignment="Left" Margin="515,202,0,0" VerticalAlignment="Top"/>
        <Button Style="{StaticResource ImageButton}" ToolTip="选择网络或文件图标" HorizontalAlignment="Left" Margin="548,113,0,0" VerticalAlignment="Top" Click="AddImage">
            <Image Source="/Resources/Images/Icons/SelectLocalImage.ico" Width="16" Height="16"/>
        </Button>
        <Button x:Name="ButtonView" Width="78" Height="78" BorderBrush="#FF707070" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="1.5,1.5,1.5,1.5" Margin="547,30,0,0" Background="White" Click="SelectImage"/>
        <Grid x:Name="ActionInfoGrid" Margin="0,66,207,80"/>
    </Grid>
</Window>