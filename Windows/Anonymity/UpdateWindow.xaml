<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Quicker.Windows.MainWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.MainWindows.UpdateWindow"
    mc:Ignorable="d"

    WindowStartupLocation="CenterScreen"
    Title="Quicker版本更新提示"
    ResizeMode="CanMinimize"
    Height="607"
    Width="645"

    Loaded="UpdateWindow_Loaded"
>
    <Window.Resources>
        <!-- 版本信息项模板 -->
        <DataTemplate x:Key="VersionInfoTemplate">
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Height="Auto" Width="500" Margin="0,10,0,10" CornerRadius="5" Background="White">
                <Grid>
                    <Border Background="#F8F9FA" CornerRadius="5" VerticalAlignment="Top" Height="60">
                        <Grid>
                            <TextBlock Text="{Binding Version}" HorizontalAlignment="Left" Margin="23,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#FF444461"/>
                            <TextBlock Text="{Binding ReleaseDate}" HorizontalAlignment="Left" Margin="91,26,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF76757D" FontSize="14"/>
                            <TextBlock Text="{Binding LatestVersionText}" HorizontalAlignment="Right" Margin="0,0,20,0" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#4DA662" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,80,0,20" HorizontalAlignment="Center" Width="460">
                        <TextBlock Text="{Binding Changelog}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <TextBlock x:Name="TitleTextBlock" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" Text="有新版本可以升级！" VerticalAlignment="Top" FontWeight="Bold" Foreground="#4DA662" FontSize="16"/>
        <Rectangle x:Name="LineRectangle" HorizontalAlignment="Center" Height="1" Margin="0,175,0,0" Fill="LightGray" VerticalAlignment="Top" Width="595"/>
        <!-- 下载按钮 -->
        <Button x:Name="DownloadButton" Content="下载并安装" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="134,89,0,0" VerticalAlignment="Top" Width="120" Click="DownloadButton_Click" Height="28" ToolTip="选择下载方式"/>
        <!-- 下载选项Popup -->
        <Popup x:Name="DownloadPopup" PlacementTarget="{Binding ElementName=DownloadButton}" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" PopupAnimation="Fade">
            <Grid>
                <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="8" RenderingBias="Quality" ShadowDepth="1"/>
                    </Border.Effect>
                </Border>
                <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                    <StackPanel Background="{x:Null}">
                        <Button x:Name="NormalDownloadButton" Content="普通版本" Style="{StaticResource MenuButton}" Width="180" Margin="0,5,0,0" Click="NormalDownloadButton_Click" ToolTip="下载普通版本"/>
                        <Button x:Name="NetDownloadButton" Content="内置.NET框架版本" Style="{StaticResource MenuButton}" Width="180" Margin="0,0,0,5" Click="NetDownloadButton_Click" ToolTip="下载内置.NET运行时版本"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
        <Button x:Name="CloseButton" Content="关闭(C)" Style="{StaticResource WhiteButton}" HorizontalAlignment="Right" Margin="0,181,33,0" VerticalAlignment="Top" Width="69" Click="CloseButton_Click" Height="28"/>
        <TextBlock x:Name="VersionTextBlock" Text="当前版本：" HorizontalAlignment="Left" Margin="10,45,0,0" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="25,95,0,0" TextWrapping="Wrap" Text="最新版本：" VerticalAlignment="Top"/>
        <TextBlock x:Name="LatestVersionTextBlock1" MouseDown="LatestVersionTextBlock_MouseDown" Cursor="Hand" HorizontalAlignment="Left" Margin="85,92,0,0" VerticalAlignment="Top" FontWeight="Bold"  Foreground="#3180F3" FontSize="16">
            <TextBlock.ToolTip>
                <ToolTip Content="查看此版本详细信息" FontWeight="Normal"/>
            </TextBlock.ToolTip>
        </TextBlock>
        <ScrollViewer Margin="20,218,20,20" Background="#E0E0E0" BorderBrush="DarkGray" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <Grid Margin="0">
                <TextBlock TextWrapping="Wrap" Text="版本更新历史" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="53,31,0,0"/>
                <TextBlock HorizontalAlignment="Left" Margin="245,41,0,0" TextWrapping="Wrap" Text="版本：" VerticalAlignment="Top" Foreground="#FF76757D" FontSize="22"/>
                <TextBlock x:Name="VersionChangeTextBlock" HorizontalAlignment="Left" Margin="311,46,0,0" TextWrapping="Wrap" Text="2.1.2 -- 2.2.0" VerticalAlignment="Top" Foreground="#FF76757D" FontSize="18"/>
                
                <!-- 版本历史列表 -->
                <ItemsControl x:Name="VersionHistoryItemsControl" ItemTemplate="{StaticResource VersionInfoTemplate}" Margin="0,100,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>