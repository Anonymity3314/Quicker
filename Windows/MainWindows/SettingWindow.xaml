<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.MainWindows.SettingWindow"
    xmlns:conv="clr-namespace:Quicker.Converters"
    mc:Ignorable="d"

    Icon="/Resources/Images/SettingWindow.png"
    WindowStartupLocation="CenterScreen"
    Title="Quicker设置"
    MinWidth="863"
    Width="1211"
    Height="870"

    Loaded="SettingWindow_Loaded"
>
    <Window.Resources>
        <conv:SearchHintVisibilityConverter x:Key="SearchHintVisibilityConverter"/>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- 侧边栏1 -->
        <StackPanel x:Name="MainStackPanel" Background="#FFE0E0E0" Width="49" HorizontalAlignment="Center">
            <Button x:Name="BasicSettings" Style="{StaticResource Button1}" ToolTip="基础设置" Background="#FFF4F4F4" Click="BasicSettings_Click" MouseLeave="BasicSettings_MouseLeave">
                <Image Source="/Resources/Images/BasicSettingsButton.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30"/>
            </Button>
            <Button Visibility="Collapsed" x:Name="Auxiliary_Functions" Style="{StaticResource Button1}" ToolTip="辅助功能" Background="#FFE0E0E0" Click="Auxiliary_Functions_Click" MouseLeave="Auxiliary_Functions_MouseLeave">
                <!--<Image Source="/Resources/Images/Quicker_Enabled.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30"/>-->
            </Button>
            <Button x:Name="Tools" Style="{StaticResource Button1}" ToolTip="工具" Background="#FFE0E0E0" Click="Tools_Click" MouseLeave="Tools_MouseLeave">
                <Image Source="/Resources/Images/Quicker_Enabled.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30"/>
            </Button>
        </StackPanel>
        <!-- 侧边栏2 -->
        <Grid x:Name="MenuGrid" Background="#FFF0F0F0" HorizontalAlignment="Center" Grid.Column="1" Width="192">
            <Grid Height="60" HorizontalAlignment="Left" VerticalAlignment="Top" Width="192">
                <Label Content="筛选..." Foreground="#FFABADB3" Visibility="{Binding ElementName=SearchBox, Path=Text, Converter={StaticResource SearchHintVisibilityConverter}}" HorizontalAlignment="Left" Margin="22,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Margin="22,0" Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource RoundedTextBox}" TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="ClearSearchTextBoxButton" Margin="149,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="16" Height="16">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ClearSearchTextBoxButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, ElementName=SearchBox}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup x:Name="SearchResultPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Width="192">
                    <Grid>
                        <Border Background="White" CornerRadius="3" Margin="3">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="6" RenderingBias="Quality" ShadowDepth="1"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="White" CornerRadius="3" Margin="3" Padding="0,3">
                            <StackPanel x:Name="SearchResultPanel"/>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            <!-- 基础设置 -->
            <StackPanel x:Name="BasicSettingsStackPanel" Width="192" Visibility="Visible" Margin="0,60,0,0">
                <Button x:Name="Convention" ToolTip="自动启动、鼠标挂钩、版本等" Style="{StaticResource Button2}" Click="Convention_Click" MouseLeave="Convention_MouseLeave">
                    <Grid Width="195">
                        <Image Source="/Resources/Images/SettingImage2.png" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="24" Width="24"/>
                        <TextBlock Text="常规" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"/>
                    </Grid>
                </Button>
                <Button x:Name="OpenMainWindow" ToolTip="面板弹出方式" Style="{StaticResource Button2}" Click="OpenMainWindow_Click" MouseLeave="OpenMainWindow_MouseLeave">
                    <Grid Width="195">
                        <Image Source="/Resources/Images/OpenMainWindow2.png" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="24" Width="24"/>
                        <TextBlock Text="弹出面板" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"/>
                    </Grid>
                </Button>
                <Button Visibility="Collapsed" x:Name="FunctionShortcutKeys" ToolTip="Quicker功能快捷键" Style="{StaticResource Button2}" Click="FunctionShortcutKeys_Click" MouseLeave="FunctionShortcutKeys_MouseLeave">
                    <Grid Width="195">
                        <Image Source="/Resources/Images/Quicker_Enabled.png" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="24" Width="24"/>
                        <TextBlock Text="功能快捷键" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"/>
                    </Grid>
                </Button>
                <Button x:Name="Blacklist" ToolTip="在某些应用上停止使用Quicker" Style="{StaticResource Button2}" Click="Blacklist_Click" MouseLeave="Blacklist_MouseLeave">
                    <Grid Width="195">
                        <Image Source="/Resources/Images/BlackList.png" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="24" Width="24"/>
                        <TextBlock Text="黑名单" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"/>
                    </Grid>
                </Button>
                <Button x:Name="Appearance" ToolTip="颜色、字体等样式设置" Style="{StaticResource Button2}" Click="Appearance_Click" MouseLeave="Appearance_MouseLeave">
                    <Grid Width="195">
                        <Image Source="/Resources/Images/Quicker_Enabled.png" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="24" Width="24"/>
                        <TextBlock Text="外观" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"/>
                    </Grid>
                </Button>
                <Button x:Name="AboutQuicker" ToolTip="应用等相关信息" Style="{StaticResource Button2}" Click="AboutQuicker_Click" MouseLeave="AboutQuicker_MouseLeave">
                    <Grid Width="195">
                        <Image Source="/Resources/Images/AboutQuicker.png" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="24" Width="24"/>
                        <TextBlock Text="关于Quicker" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"/>
                    </Grid>
                </Button>
            </StackPanel>
            <!-- 辅助功能 -->
            <StackPanel x:Name="Auxiliary_FunctionsStackPanel" Width="192" Margin="0,60,0,0" Visibility="Hidden"/>
            <!-- 工具 -->
            <StackPanel x:Name="ToolsStackPanel" Width="192" Margin="0,60,0,0" Visibility="Hidden">
                <Button x:Name="ManageExtensions" ToolTip="进行扩展管理" Style="{StaticResource Button2}" Click="ManageExtensions_Click" MouseLeave="ManageExtensions_MouseLeave">
                    <Grid Width="195">
                        <Image Source="/Resources/Images/Quicker_Enabled.png" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="24" Width="24"/>
                        <TextBlock Text="管理扩展" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
        <!-- 设置菜单 -->
        <Grid x:Name="ResultGrid" Margin="4,0,0,0" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14*"/>
                <ColumnDefinition Width="953*"/>
            </Grid.ColumnDefinitions>
            <!-- 保存设置 -->
            <Rectangle Fill="#FFD5D5D5" VerticalAlignment="Top" Height="1" Margin="0,43,0,0" Grid.Column="1" Panel.ZIndex="1"/>
            <Grid x:Name="SettingButtonsGrid" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="42" Width="188" Margin="0,0,50,30" Panel.ZIndex="1">
                <Button x:Name="ApplySettingsButton" Content="应用设置" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="59,0,0,0" Click="ApplySettings" FontSize="16" Width="129" Height="42"/>
                <Button x:Name="CancelSettingsButton" ToolTip="撤销修改" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="42" Width="43" Click="CancelSettingsButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>