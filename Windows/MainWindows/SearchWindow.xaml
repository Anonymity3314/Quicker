<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Quicker.Windows.MainWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.MainWindows.SearchWindow"
    xmlns:helpers="clr-namespace:Quicker.Helpers"
    mc:Ignorable="d"

    WindowStartupLocation="CenterScreen"
    AllowsTransparency="True"
    SizeToContent="Height"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Background="{x:Null}"
    WindowStyle="None"
    Topmost="True"

    Deactivated="SearchWindow_Deactivated"
    Loaded="SearchWindow_Loaded"
>
    <Window.Resources>
        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="53"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MaxHeight="358" MinHeight="40" Width="719">
        <!-- 窗口阴影 -->
        <Border x:Name="ShadowBorder" Margin="0.6" Background="#FFF3F3F3" CornerRadius="5">
            <Border.Effect>
                <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
            </Border.Effect>
        </Border>
        <Border x:Name="SearchBorder" Margin="0.6" Background="White" CornerRadius="5" helpers:ClipHelper.ClipToBounds="True">
            <StackPanel x:Name="stackPanel">
                <Grid Height="50">
                    <TextBox x:Name="SearchBox" Text="开始搜索..." Width="700" Height="40" FontSize="28" TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center" BorderThickness="0" Foreground="LightGray" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <EventSetter Event="GotFocus" Handler="SearchBox_GotFocus"/>
                                <EventSetter Event="LostFocus" Handler="SearchBox_LostFocus"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
                <Button x:Name="Btn1" Style="{StaticResource SearchButtonStyle}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36" Width="36" Margin="10,0,0,0"/>
                        <TextBlock Text="作为命令运行" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,8,0,0"/>
                        <TextBlock Text="运行命令" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="51,0,0,9" FontSize="10" Foreground="LightGray"/>
                        <TextBlock Text="{Binding Text, ElementName=SearchBox, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,31,0,0" FontSize="10" Foreground="LightGray"/>
                    </Grid>
                </Button>
                <Button x:Name="Btn2" Style="{StaticResource SearchButtonStyle}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36" Width="36" Margin="10,0,0,0"/>
                        <TextBlock Text="打开网址" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,8,0,0"/>
                        <TextBlock Text="作为网址打开" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="51,0,0,9" FontSize="10" Foreground="LightGray"/>
                        <TextBlock Text="{Binding Text, ElementName=SearchBox, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,8,0,0" FontSize="16"/>
                    </Grid>
                </Button>
                <Button x:Name="Btn3" Style="{StaticResource SearchButtonStyle}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36" Width="36" Margin="10,0,0,0"/>
                        <TextBlock Text="必应搜索" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,8,0,0"/>
                        <TextBlock Text="作为网址打开" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="51,0,0,9" FontSize="10" Foreground="LightGray"/>
                        <TextBlock Text="{Binding Text, ElementName=SearchBox, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,8,0,0" FontSize="16"/>
                    </Grid>
                </Button>
                <Button x:Name="Btn4" Style="{StaticResource SearchButtonStyle}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36" Width="36" Margin="10,0,0,0"/>
                        <TextBlock Text="百度搜索" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,8,0,0"/>
                        <TextBlock Text="作为网址打开" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="51,0,0,9" FontSize="10" Foreground="LightGray"/>
                        <TextBlock Text="{Binding Text, ElementName=SearchBox, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,8,0,0" FontSize="16"/>
                    </Grid>
                </Button>
                <Button x:Name="Btn5" Style="{StaticResource SearchButtonStyle}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36" Width="36" Margin="10,0,0,0"/>
                        <TextBlock Text="谷歌搜索" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,8,0,0"/>
                        <TextBlock Text="作为网址打开" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="51,0,0,9" FontSize="10" Foreground="LightGray"/>
                        <TextBlock Text="{Binding Text, ElementName=SearchBox, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,8,0,0" FontSize="16"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>