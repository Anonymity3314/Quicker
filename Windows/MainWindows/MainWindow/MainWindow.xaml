<Window
    xmlns:mainwindow="clr-namespace:Quicker.Windows.MainWindows.MainWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=mainwindow:MainWindowViewModel}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    x:Class="Quicker.Windows.MainWindows.MainWindow.MainWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:styles="clr-namespace:Quicker.Resources.Styles"
    xmlns:helpers="clr-namespace:Quicker.Helpers"
    xmlns:conv="clr-namespace:Quicker.Converters"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"

    AllowsTransparency="True"
    ShowInTaskbar="False"
    Background="{x:Null}"
    ResizeMode="NoResize"
    WindowStyle="None"
    Topmost="True"

    MouseLeftButtonDown="MoveMainWindow"
    Deactivated="MainWindow_Deactivated"
    Closing="MainWindow_Closing"
    Loaded="MainWindow_Loaded"
>
    <Window.Resources>
        <conv:PathToImageSourceConverter x:Key="PathToImageSourceConverter"/>
        <conv:IntToCornerRadiusConverter x:Key="IntToCornerRadiusConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:DoubleSubtractConverter x:Key="DoubleSubtractConverter"/>
        <conv:BorderHeightConverter x:Key="BorderHeightConverter"/>
        <conv:BlurEffectConverter x:Key="BlurEffectConverter"/>
        <conv:GridHeightConverter x:Key="GridHeightConverter"/>
        <conv:FontWeightConverter x:Key="FontWeightConverter"/>
        <conv:GridWidthConverter x:Key="GridWidthConverter"/>
        <conv:ThicknessConverter x:Key="ThicknessConverter"/>
        <conv:ButtonBackgroundConverter x:Key="ButtonBackgroundConverter"/>
        <!-- 按钮模板 -->
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="BorderBrush" Value="{Binding BorderColor}"/>
            <Setter Property="FontWeight" Value="{Binding FontWeight}"/>
            <Setter Property="FontSize" Value="{Binding FontSize}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Content" Value="{x:Null}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Tag" Value="{x:Null}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ButtonBackgroundConverter}">
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="DataContext.ActionButtonColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.ActionButtonMouseOverColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.BlankButtonColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.BlankButtonMouseOverColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{Binding BorderWidth, Converter={StaticResource ThicknessConverter}}" Background="{TemplateBinding Background}" CornerRadius="{Binding ButtonCornerRadius}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" CenterX="0.5" CenterY="0.5"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 放大动画 -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}" />
                                    <Condition Binding="{Binding DataContext.ShowActionButtonMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Height>
            <MultiBinding Converter="{StaticResource BorderHeightConverter}">
                <Binding Path="ButtonSize"/>
                <Binding Path="ButtonGap"/>
            </MultiBinding>
        </Grid.Height>
        <Grid.Width>
            <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                <Binding Path="ButtonSize"/>
                <Binding Path="ButtonGap"/>
            </MultiBinding>
        </Grid.Width>
        <!-- 窗口阴影 -->
        <Border x:Name="ShadowBorder" Margin="0.6" Background="#FFF3F3F3" CornerRadius="{Binding Win11CornerRadius, Converter={StaticResource IntToCornerRadiusConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
            </Border.Effect>
        </Border>
        <!-- 窗口模糊 -->
        <Border x:Name="BlurBorder" Background="Transparent" CornerRadius="{Binding Win11CornerRadius, Converter={StaticResource IntToCornerRadiusConverter}}">
            <Border.Effect>
                <BlurEffect Radius="15" RenderingBias="Quality"/>
            </Border.Effect>
        </Border>
        <!-- 窗口内容 -->
        <Border x:Name="ViewBorder" CornerRadius="{Binding Win11CornerRadius, Converter={StaticResource IntToCornerRadiusConverter}}" Background="{Binding BackgroundColor}" helpers:ClipHelper.ClipToBounds="True">
            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="{Binding ElementName=GlobalGrid, Path=ActualHeight}"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="{Binding ElementName=CommonGrid, Path=ActualHeight}"/>
                </Grid.RowDefinitions>
                <!-- 背景图片 -->
                <Image x:Name="BackgroundImage" Stretch="Fill" Source="{Binding BackgroundImagePath, Converter={StaticResource PathToImageSourceConverter}}" Opacity="{Binding BackgroundImageOpacity}" Width="{Binding ActualWidth, ElementName=ViewBorder}" Height="{Binding ActualHeight, ElementName=ViewBorder}" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0" Grid.RowSpan="4"/>
                <!-- 标题栏 -->
                <Grid x:Name="TitleBarGrid" Grid.RowSpan="1" Background="{Binding ToolbarColor}">
                    <Label Content="Quicker" Width="58" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#A1A1A1" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Button styles:ParentBackgroundHelper.ParentBackground="{Binding Background, ElementName=TitleBarGrid}" Style="{StaticResource Task}" Click="OpenSettingWindow" ToolTip="打开设置窗口" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="58,0,0,0">
                        <Image Source="/Resources/Images/SettingImage2.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ActionPageManager" styles:ParentBackgroundHelper.ParentBackground="{Binding Background, ElementName=TitleBarGrid}" Style="{StaticResource Task}" Click="OpenTitleMenu" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="82,0,0,0">
                        <Grid>
                            <Image Source="/Resources/Images/MoreSelection.png" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Border x:Name="HasNewVersionTip" CornerRadius="4" Background="#11AD45" Margin="12,12,0,0"/>
                        </Grid>
                    </Button>
                    <Popup x:Name="TitlePop" PopupAnimation="Fade" Width="180" Height="95" PlacementTarget="{Binding ElementName=ActionPageManager}" AllowsTransparency="True" StaysOpen="False">
                        <Grid>
                            <Rectangle Fill="White" Margin="3,5">
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="8" RenderingBias="Quality" ShadowDepth="1"/>
                                </Rectangle.Effect>
                            </Rectangle>
                            <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                                <StackPanel Background="{x:Null}">
                                    <Button Style="{StaticResource MenuButton}" ToolTip="为应用程序创建场景设置，管理动作页" Margin="0,3,0,0" Click="OpenActionPageManageWindow">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/ActionPagesManager.jpg" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="场景与动作" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="UpdateButton" Style="{StaticResource MenuButton}" Click="UpdateQuicker">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="升级Quicker" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                                        </Grid>
                                    </Button>
                                    <Rectangle Height="1" Width="176" Fill="#FFF0F0F0" Margin="0,3"/>
                                    <Button Style="{StaticResource MenuButton}" ToolTip="关闭Quicker软件" Click="QuitQuicker">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/CloseQuicker.png" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="退出" TextAlignment="Left" Margin="26,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Popup>
                    <Button Style="{StaticResource Task}" styles:ParentBackgroundHelper.ParentBackground="{Binding Background, ElementName=TitleBarGrid}" Click="BookQuicker" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="订住：固定位置，不自动隐藏"/>
                                    <TextBlock Text="订住需点击×关闭窗口"/>
                                    <!--<TextBlock Text="右键点击可打开面板浮标"/>-->
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Image x:Name="Book" Source="/Resources/Images/UnpinFromDesktop.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource Task}" styles:ParentBackgroundHelper.ParentBackground="{Binding Background, ElementName=TitleBarGrid}" Click="CloseMainWindow" ToolTip="关闭面板窗口" HorizontalAlignment="Right" Margin="0,0,1,0" Drop="CloseMainWindowButton_Drop">
                        <Image x:Name="Close" Source="/Resources/Images/CloseWindow.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <!-- 全局动作 -->
                <Grid x:Name="GlobalGrid" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Row="1" MouseWheel="GolbalGrid_MouseWheel">
                    <Grid.Height>
                        <MultiBinding Converter="{StaticResource GridHeightConverter}" ConverterParameter="3">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Height>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Width>
                    <Grid x:Name="Global0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding ButtonGap}"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding ButtonGap}"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding ButtonGap}"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{Binding ButtonGap}"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{Binding ButtonGap}"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 第一行 -->
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="0" Grid.Column="6" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <!-- 第二行 -->
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="2" Grid.Column="6" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <!-- 第三行 -->
                        <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="4" Grid.Column="6" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                    </Grid>
                </Grid>
                <!-- 功能栏 -->
                <Grid x:Name="FunctionBarGrid" VerticalAlignment="Center" Height="25" Grid.Row="2" Background="{Binding ToolbarColor}">
                    <TextBlock x:Name="CommonTextBlock" Text="默认" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#A1A1A1" TextAlignment="Center" MouseDown="CommonTextBlock_MouseDown" Margin="10,0" Cursor="Hand"/>
                    <StackPanel x:Name="GlobalButtonPanel" Margin="77.6,0,77.6,13" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="CommonButtonPanel" Margin="0,13,0,0" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <Button x:Name="ActionPageSelecter" HorizontalAlignment="Right" Margin="0,0,34,0" styles:ParentBackgroundHelper.ParentBackground="{Binding Background, ElementName=FunctionBarGrid}" Style="{StaticResource Task}" Click="LockCommonActionPage" MouseRightButtonDown="OpenSelectActionPageMenu">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="锁定/解锁动作页自动切换"/>
                                    <TextBlock Text="右键点击：切换应用动作页并锁定"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Image x:Name="Lock" Source="/Resources/Images/UnLocked.png" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <!-- 通用动作 -->
                <Grid x:Name="CommonGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="3" MouseWheel="CommonGrid_MouseWheel">
                    <Grid.Height>
                        <MultiBinding Converter="{StaticResource GridHeightConverter}" ConverterParameter="4">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Height>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Width>
                    <Grid x:Name="Common0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding ButtonGap}"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding ButtonGap}"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding ButtonGap}"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding ButtonGap}"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{Binding ButtonGap}"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{Binding ButtonGap}"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{Binding ButtonGap}"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{Binding ButtonGap}"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 第一行 -->
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="0" Grid.Column="6" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <!-- 第二行 -->
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="2" Grid.Column="6" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <!-- 第三行 -->
                        <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <Button Grid.Row="4" Grid.Column="6" Style="{StaticResource Button}" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" Click="DoAction" Drop="Button_Drop" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave" PreviewDragOver="Button_PreviewDragOver" MouseRightButtonDown="OpenCreatActionMenu" PreviewMouseMove="Button_PreviewMouseMove" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
                        <!-- 第四行 -->
