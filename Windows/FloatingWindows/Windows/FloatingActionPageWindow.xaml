<Window
    d:DataContext="{d:DesignInstance Type=viewmodels:FloatingActionPageWindowViewModel}"
    xmlns:viewmodels="clr-namespace:Quicker.Windows.FloatingWindows.ViewModels"
    x:Class="Quicker.Windows.FloatingWindows.Windows.FloatingActionPageWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Quicker.Windows.FloatingWindows.Windows"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Quicker.Helpers"
    xmlns:conv="clr-namespace:Quicker.Converters"
    mc:Ignorable="d"

    AllowsTransparency="True"
    Background="{x:Null}"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStyle="None"
    Height="450"
    Width="450"

    Unloaded="FloatingActionPageWindow_Unloaded"
    Loaded="FloatingActionPageWindow_Loaded"
>
    <Window.Resources>
        <!-- 图片资源 -->
        <ImageSource x:Key="UnpinFromDesktopSource">pack://application:,,,/Resources/Images/UnpinFromDesktop.png</ImageSource>
        <ImageSource x:Key="PinToDesktopSource">pack://application:,,,/Resources/Images/PinToDesktop.png</ImageSource>
        <!-- 转换器 -->
        <conv:SmartHoverColorConverter x:Key="SmartHoverColorConverter" DarkerFactor="0.8" LighterFactor="1.2"/>
        <conv:IntToCornerRadiusConverter x:Key="IntToCornerRadiusConverter"/>
        <conv:ButtonBackgroundConverter x:Key="ButtonBackgroundConverter"/>
        <conv:GridWidthConverter x:Key="GridWidthConverter"/>
        <conv:ThicknessConverter x:Key="ThicknessConverter"/>
        <!-- 按钮样式 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding DataContext.ButtonTextColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderBrush" Value="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="FontWeight" Value="{Binding DataContext.FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="FontSize" Value="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ButtonBackgroundConverter}">
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="DataContext.ActionButtonColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.ActionButtonMouseOverColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.BlankButtonColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.BlankButtonMouseOverColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{Binding DataContext.BorderWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ThicknessConverter}}" Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 标题栏Button -->
        <Style x:Key="Task" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding DataContext.ToolbarColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SmartHoverColorConverter}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
        <Grid.Width>
            <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                <Binding Path="ButtonSize"/>
                <Binding Path="ButtonGap"/>
            </MultiBinding>
        </Grid.Width>
        <Grid.Height>
            <Binding Path="GridHeight"/>
        </Grid.Height>
        <!-- 窗口阴影 -->
        <Border x:Name="ShadowBorder" Visibility="{Binding ElementName=ViewBorder, Path=Visibility}" Margin="0.6" Background="#F3F3F3" CornerRadius="{Binding DataContext.Win11CornerRadius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntToCornerRadiusConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="10" RenderingBias="Quality" ShadowDepth="1"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <!-- Blur == 0: 有阴影，Opacity=1 -->
                        <DataTrigger Binding="{Binding DataContext.Blur, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="10" RenderingBias="Quality" ShadowDepth="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <!-- Blur == 1: 有阴影，Opacity=0.5 -->
                        <DataTrigger Binding="{Binding DataContext.Blur, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="10" RenderingBias="Quality" ShadowDepth="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <!-- Blur == 2: 无阴影，Opacity=1 -->
                        <DataTrigger Binding="{Binding DataContext.Blur, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <!-- Blur == 3: 无阴影，Opacity=0.5 -->
                        <DataTrigger Binding="{Binding DataContext.Blur, RelativeSource={RelativeSource AncestorType=Window}}" Value="3">
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <!-- 窗口模糊 -->
        <Border x:Name="BlurBorder" Visibility="{Binding ElementName=ViewBorder, Path=Visibility}" Background="Transparent" CornerRadius="{Binding DataContext.Win11CornerRadius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntToCornerRadiusConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <!-- Blur == 1: 有模糊 -->
                        <DataTrigger Binding="{Binding DataContext.Blur, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <!-- Blur == 3: 有模糊 -->
                        <DataTrigger Binding="{Binding DataContext.Blur, RelativeSource={RelativeSource AncestorType=Window}}" Value="3">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <!-- 窗口内容 -->
        <Border x:Name="ViewBorder" CornerRadius="{Binding DataContext.Win11CornerRadius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntToCornerRadiusConverter}}" Background="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}}" helpers:ClipHelper.ClipToBounds="True" MouseLeave="ViewBorder_MouseLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="31"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="TitleGrid" Height="31" VerticalAlignment="Center" HorizontalAlignment="Left" MouseLeftButtonDown="TitleGrid_MouseLeftButtonDown" MouseRightButtonDown="TitleGrid_MouseRightButtonDown" Background="{Binding DataContext.ToolbarColor, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Row="0">
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Width>
                    <TextBlock x:Name="TitleTextBlock" Margin="5,7" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Style="{StaticResource Task}" Click="PinToDesktop" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="订住：固定位置，不自动隐藏"/>
                                    <TextBlock Text="订住需点击×关闭窗口"/>
                                    <!--<TextBlock Text="右键点击可打开面板浮标"/>-->
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Rectangle Width="20" Height="20" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="OpacityMask">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="{StaticResource UnpinFromDesktopSource}"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <ImageBrush ImageSource="{StaticResource PinToDesktopSource}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Button>
                    <Button Style="{StaticResource Task}" Click="CloseWindow" ToolTip="关闭面板窗口" HorizontalAlignment="Right" Margin="0,0,3,0">
                        <Rectangle Width="20" Height="20" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/Images/CloseWindow.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                </Grid>
                <Grid x:Name="ActionButtonGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Background="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding ButtonSize}"/>
                        <!-- 按钮行1 -->
                        <RowDefinition Height="{Binding ButtonGap}"/>
                        <!-- 间隔 -->
                        <RowDefinition Height="{Binding ButtonSize}"/>
                        <!-- 按钮行2 -->
                        <RowDefinition Height="{Binding ButtonGap}"/>
                        <!-- 间隔 -->
                        <RowDefinition Height="{Binding ButtonSize}"/>
                        <!-- 按钮行3 -->
                        <RowDefinition Height="{Binding ButtonGap}"/>
                        <!-- 间隔 -->
                        <RowDefinition Height="{Binding ButtonSize}"/>
                        <!-- 按钮行4 -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ButtonSize}"/>
                        <!-- 按钮列1 -->
                        <ColumnDefinition Width="{Binding ButtonGap}"/>
                        <!-- 间隔 -->
                        <ColumnDefinition Width="{Binding ButtonSize}"/>
                        <!-- 按钮列2 -->
                        <ColumnDefinition Width="{Binding ButtonGap}"/>
                        <!-- 间隔 -->
                        <ColumnDefinition Width="{Binding ButtonSize}"/>
                        <!-- 按钮列3 -->
                        <ColumnDefinition Width="{Binding ButtonGap}"/>
                        <!-- 间隔 -->
                        <ColumnDefinition Width="{Binding ButtonSize}"/>
                        <!-- 按钮列4 -->
                    </Grid.ColumnDefinitions>
                    <!-- 第1行按钮 -->
                    <Button Grid.Row="0" Grid.Column="0" x:Name="Button11" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="0" Grid.Column="2" x:Name="Button12" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="0" Grid.Column="4" x:Name="Button13" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="0" Grid.Column="6" x:Name="Button14" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <!-- 第2行按钮 -->
                    <Button Grid.Row="2" Grid.Column="0" x:Name="Button21" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="2" Grid.Column="2" x:Name="Button22" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="2" Grid.Column="4" x:Name="Button23" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="2" Grid.Column="6" x:Name="Button24" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <!-- 第3行按钮 -->
                    <Button Grid.Row="4" Grid.Column="0" x:Name="Button31" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="4" Grid.Column="2" x:Name="Button32" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="4" Grid.Column="4" x:Name="Button33" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="4" Grid.Column="6" x:Name="Button34" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <!-- 第4行按钮 -->
                    <Button Grid.Row="6" Grid.Column="0" x:Name="Button41" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="6" Grid.Column="2" x:Name="Button42" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="6" Grid.Column="4" x:Name="Button43" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                    <Button Grid.Row="6" Grid.Column="6" x:Name="Button44" Style="{StaticResource ActionButton}" Click="ActionButton_Click" MouseRightButtonDown="ActionButton_MouseRightButtonDown"/>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="Border" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" Background="Black" MouseEnter="Border_MouseEnter" Visibility="Collapsed">
            <TextBlock Text="{Binding ElementName=TitleTextBlock, Path=Text}" FontSize="16" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>