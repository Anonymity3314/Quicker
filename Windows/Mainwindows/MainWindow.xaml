<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.MainWindows.MainWindow"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"
    
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Background="{x:Null}"
    ResizeMode="NoResize"
    WindowStyle="None"
    Topmost="True"
    
    MouseLeftButtonDown="MoveMainWindow"
    Deactivated="MainWindow_Deactivated"
    Closing="MainWindow_Closing"
    Loaded="MainWindow_Loaded"
>
    <Border CornerRadius="5" Width="310.4" Height="596">
        <Grid x:Name="MainGrid">
            <!-- 窗口阴影 -->
            <Rectangle Fill="White" Margin="5,7">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="50" RenderingBias="Quality" ShadowDepth="1"/>
                </Rectangle.Effect>
            </Rectangle>
            <!-- 标题栏 -->
            <Border BorderThickness="0" CornerRadius="5" Padding="1" Background="#F3F3F3">
                <Grid VerticalAlignment="Top" Height="27" Background="{x:Null}">
                    <Label Content="Quicker" Width="58" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#A1A1A1" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Button Style="{StaticResource Task}" Click="OpenSettingWindow" ToolTip="打开设置窗口" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="58,0,0,0">
                        <Image Source="/Resources/Images/SettingImage2.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ActionPageManager" Style="{StaticResource Task}" Click="OpenTitleMenu" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="82,0,0,0">
                        <Grid>
                            <Image Source="/Resources/Images/MoreSelection.png" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Border x:Name="HasNewVersionTip" CornerRadius="4,4,4,4" Background="#11AD45" Margin="12,12,0,0"/>
                        </Grid>
                    </Button>
                    <Popup x:Name="TitlePop" PopupAnimation="Fade" Width="180" Height="95" PlacementTarget="{Binding ElementName=ActionPageManager}" AllowsTransparency="True" StaysOpen="False">
                        <Grid>
                            <Rectangle Fill="White" Margin="3,5">
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="8" RenderingBias="Quality" ShadowDepth="1"/>
                                </Rectangle.Effect>
                            </Rectangle>
                            <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                                <StackPanel Background="{x:Null}">
                                    <Button Style="{StaticResource MenuButton}" ToolTip="为应用程序创建场景设置，管理动作页" Margin="0,3,0,0" Click="OpenActionPageManageWindow">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/ActionPagesManager.jpg" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="场景与动作" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="UpdateButton" Style="{StaticResource MenuButton}" Click="UpdateQuicker">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="升级Quicker" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                                        </Grid>
                                    </Button>
                                    <Rectangle Height="1" Width="176" Fill="#FFF0F0F0" Margin="0,3"/>
                                    <Button Style="{StaticResource MenuButton}" ToolTip="关闭Quicker软件" Click="QuitQuicker">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/CloseQuicker.png" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="退出" TextAlignment="Left" Margin="26,0,0,0" FontSize="13"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Popup>
                    <Button Style="{StaticResource Task}" Click="BookQuicker" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="订住：固定位置，不自动隐藏"/>
                                    <TextBlock Text="订住需点击×关闭窗口"/>
                                    <!--<TextBlock Text="右键点击可打开面板浮标"/>-->
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Image x:Name="Book" Source="/Resources/Images/UnpinFromDesktop.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CloseMainWindowButton}" Click="CloseMainWindow" ToolTip="关闭面板窗口" Margin="283,0,0,0" Drop="CloseMainWindowButton_Drop"/>
                </Grid>
            </Border>
            <!-- 全局动作 -->
            <Grid x:Name="GlobalGrid" VerticalAlignment="Top" Height="232.8" Width="310.4" Margin="0,28,0,0" MouseWheel="GolbalGrid_MouseWheel">
                <UniformGrid x:Name="ViewGlobalUniformGrid" Rows="3" Columns="4">
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                </UniformGrid>
            </Grid>
            <!-- 功能栏 -->
            <Grid VerticalAlignment="Top" Height="25" Background="#F3F3F3" Margin="0,261,0,0" >
                <TextBlock x:Name="CommonTextBlock" Text="默认" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FF8D8D8D" TextAlignment="Center" MouseDown="CommonTextBlock_MouseDown" Margin="10,0" Cursor="Hand"/>
                <StackPanel x:Name="GlobalButtonPanel" Margin="77.6,0,77.6,13" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <StackPanel x:Name="CommonButtonPanel" Margin="0,13,0,0" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" CornerRadius="5" Padding="1" Background="#F3F3F3" Width="24" Height="24" Margin="253,0,0,0">
                    <Button x:Name="ActionPageSelecter" Style="{StaticResource Task}" Click="LockCommonActionPage" MouseRightButtonDown="OpenSelectActionPageMenu">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="锁定/解锁动作页自动切换"/>
                                    <TextBlock Text="右键点击：切换应用动作页并锁定"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Image x:Name="Lock" Source="/Resources/Images/UnLocked.png" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Border>
            </Grid>
            <!-- 通用动作 -->
            <Grid x:Name="CommonGrid" Height="310.4" Width="310.4" Margin="0,286,0,0" MouseWheel="CommonGrid_MouseWheel">
                <UniformGrid x:Name="ViewCommonUniformGrid" Rows="4" Columns="4">
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource SpecialButton1}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource Button}"/>
                    <Button Style="{StaticResource SpecialButton2}"/>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>