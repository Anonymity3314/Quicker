<Window 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Quicker.Windows"
    x:Class="Quicker.Windows.CreatActionMenu"
    mc:Ignorable="d"

    AllowsTransparency="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Background="{x:Null}"
    WindowStyle="None"
    Topmost="True"
    Height="440"
    Width="758"
    
    IsVisibleChanged="CreatActionMenu_IsVisibleChanged"
    Deactivated="CreatActionMenu_Deactivated"
>
    <Grid x:Name="MainGrid" Width="178" Height="142">
        <!-- 窗口阴影 -->
        <Rectangle Fill="White" Margin="5,7">
            <Rectangle.Effect>
                <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
            </Rectangle.Effect>
        </Rectangle>
        <Border CornerRadius="3" Background="White">
            <StackPanel>
                <Button x:Name="PasteActionButton" Click="PasteActionButton_Click" Style="{StaticResource MenuButton}" Margin="0,5,0,3">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                        <TextBlock x:Name="PasteActionTextBlock" Style="{StaticResource MenuButtonTextBlock}"/>
                    </Grid>
                </Button>
                <Rectangle x:Name="Line1" Height="1" Fill="#FFF0F0F0"/>
                <Button x:Name="StartAppButton" Click="StartApp" Style="{StaticResource MenuButton}" Margin="0,3,0,0">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                        <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="启动软件"/>
                    </Grid>
                </Button>
                <Button Click="OpenDocument" Style="{StaticResource MenuButton}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                        <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="打开文件"/>
                    </Grid>
                </Button>
                <Button Click="OpenFolder" Style="{StaticResource MenuButton}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                        <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="打开文件夹"/>
                    </Grid>
                </Button>
                <Button Click="OpenWebsite" Style="{StaticResource MenuButton}">
                    <Grid>
                        <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                        <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="打开网址"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>