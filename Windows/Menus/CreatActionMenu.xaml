<Window 
    mc:Ignorable="d"
    x:Class="Quicker.Windows.CreatActionMenu"
    xmlns:local="clr-namespace:Quicker.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    Width="178"   
    Height="110" 
    WindowStyle="None" 
    Background="{x:Null}" 
    ResizeMode="NoResize" 
    ShowInTaskbar="False" 
    AllowsTransparency="True" 
    WindowStartupLocation="Manual"
    
    Deactivated="Window_Deactivated"
>
    <Window.Resources>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="White" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEAEAEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="30,0,0,0"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Width" Value="166"/>
        </Style>
        <Style x:Key="Image" TargetType="Image">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Width" Value="166"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="White" BorderThickness="0" CornerRadius="3" Padding="1" Background="White">
            <StackPanel Margin="-1,-1,-1,-1">
                <Button Click="StartApp" Style="{StaticResource Button}" Margin="0,5,0,0">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource Image}"/>
                        <TextBlock Style="{StaticResource TextBlock}" Margin="30,0,0,0" Width="144" Text="启动软件"/>
                    </Grid>
                </Button>
                <Button Click="OpenDocument" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource Image}"/>
                        <TextBlock Style="{StaticResource TextBlock}" Margin="30,0,0,0" Width="144"><Run Language="zh-cn" Text="打开文件"/></TextBlock>
                    </Grid>
                </Button>
                <Button Click="OpenFolder" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource Image}"/>
                        <TextBlock Height="16" Width="144" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="打开文件夹"/></TextBlock>
                    </Grid>
                </Button>
                <Button Click="OpenWebsite" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Width="16" Margin="7,0,7,0"/>
                        <TextBlock Height="16" Width="144" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="打开网址"/><LineBreak/><Run Language="zh-cn"/></TextBlock>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
