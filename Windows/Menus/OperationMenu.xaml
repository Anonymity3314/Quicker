<Window 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Quicker.Windows.Menus"
    x:Class="Quicker.Windows.Menus.OperationMenu"
    mc:Ignorable="d"

    AllowsTransparency="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Background="{x:Null}"
    WindowStyle="None"
    Topmost="True"
    Height="451"
    Width="784"

    Deactivated="OperationMenu_Deactivated"
    Loaded="OperationMenu_Loaded"
>
    <Grid>
        <Grid x:Name="MainGrid" Height="255" Width="204" Margin="15,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- 窗口阴影 -->
            <Border Background="White" Margin="5">
                <Border.Effect>
                    <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="5" Background="White">
                <StackPanel x:Name="MainStackPanel">
                    <Button x:Name="CloseFloatButton" Style="{StaticResource MenuButton}" ToolTip="关闭悬浮窗" Margin="0,5,0,0" Click="CloseFloatButton_Click">
                        <Grid Width="194">
                            <Image Source="/Resources/Images/DeleteImage.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="关闭"/>
                        </Grid>
                    </Button>
                    <Rectangle x:Name="Rectangle1" Height="1" Fill="#FFF0F0F0" Width="204" Margin="0,3"/>
                    <Button x:Name="EditeInformation" Style="{StaticResource MenuButton}" Click="EditeInformation_Click">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="编辑动作定义"/>
                                <TextBlock Text="【面板窗口快速触发方式】左Shift+点击。"/>
                            </StackPanel>
                        </Button.ToolTip>
                        <Grid Width="194">
                            <Image Source="/Resources/Images/EditButton.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="编辑"/>
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Fill="#FFF0F0F0" Width="204" Margin="0,3"/>
                    <Button x:Name="SuspendAction" Style="{StaticResource MenuButton}" ToolTip="悬浮动作" Click="SuspendAction_Click">
                        <Grid Width="194">
                            <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="悬浮"/>
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Fill="#FFF0F0F0" Width="204" Margin="0,3"/>
                    <Button x:Name="CopyAction" Style="{StaticResource MenuButton}" Click="CopyAction_Click">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="复制动作"/>
                                <TextBlock Text="Ctrl+点击可连同复制动作ID"/>
                                <TextBlock Text="【面板窗口快速复制】Ctrl+拖动动作"/>
                            </StackPanel>
                        </Button.ToolTip>
                        <Grid Width="199">
                            <Image Source="/Resources/Images/CopyAction.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="复制"/>
                        </Grid>
                    </Button>
                    <Button x:Name="CutAction" ToolTip="复制并删除动作" Style="{StaticResource MenuButton}" Click="CutAction_Click">
                        <Grid Width="199">
                            <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="剪切"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DeleteAction" ToolTip="【面板窗口快速触发方式】拖动动作到右上角的关闭按钮" Style="{StaticResource MenuButton}" Click="DeleteAction_Click">
                        <Grid Width="199">
                            <Image Source="/Resources/Images/DeleteImage.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="删除"/>
                        </Grid>
                    </Button>
                    <Button x:Name="PasteIcon" ToolTip="设置动作图标为剪贴板图片" Style="{StaticResource MenuButton}" Click="PasteIcon_Click">
                        <Grid Width="199">
                            <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="粘贴图标"/>
                        </Grid>
                    </Button>
                    <Button x:Name="OtherFunction" ToolTip="其它功能" Style="{StaticResource MenuButton}" MouseEnter="OtherFunction_MouseEnter" MouseLeave="OtherFunction_MouseLeave">
                        <Grid Width="198">
                            <Image Source="/Resources/Images/ActionInformation.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="信息"/>
                        </Grid>
                    </Button>
                    <Button x:Name="OpenLocation" ToolTip="在资源管理器中找到对应文件或文件夹" Style="{StaticResource MenuButton}" Margin="0,0,0,5" Click="OpenLocation_Click">
                        <Grid Width="194">
                            <Image Source="/Resources/Images/OpenFile.png" Style="{StaticResource MenuButtonImage}"/>
                            <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="打开所在位置"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="ChiildGrid" Margin="219,147,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="FirstChildGrid" Margin="0,0,0,0" MouseLeave="FirstChildGrid_MouseLeave" VerticalAlignment="Top" HorizontalAlignment="Left">
                <!-- 窗口阴影 -->
                <Rectangle Fill="White" Margin="5,7">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Border CornerRadius="3" Background="White">
                    <StackPanel>
                        <Button x:Name="ExportAction" Style="{StaticResource MenuButton}" ToolTip="导出动作定义到文件" Margin="0,3" Click="ExportAction_Click">
                            <Grid Width="130">
                                <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                                <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="导出动作"/>
                            </Grid>
                        </Button>
                        <Rectangle Height="1" Fill="#FFF0F0F0" Width="130"/>
                        <Button x:Name="CheckImformation" Style="{StaticResource MenuButton}" ToolTip="查看动作信息" Margin="0,3,0,0" Click="CheckImformation_Click">
                            <Grid Width="130">
                                <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                                <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="查看信息"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CopyActionInfo" Style="{StaticResource MenuButton}" Margin="0,0,0,3" MouseEnter="CopyActionInfo_MouseEnter" MouseLeave="CopyActionInfo_MouseLeave">
                            <Grid Width="130">
                                <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}" Margin="7,0,0,0"/>
                                <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="复制"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="SecondChildGrid" Margin="130,57,0,0" MouseLeave="SecondChildGrid_MouseLeave" VerticalAlignment="Top" HorizontalAlignment="Left">
                <!-- 窗口阴影 -->
                <Border Background="White" Margin="5">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="3" Background="White">
                    <StackPanel>
                        <Button x:Name="CopyActionID" Style="{StaticResource MenuButton}" ToolTip="复制动作的ID文字" Margin="0,3,0,0" Click="CopyActionID_Click">
                            <Grid Width="130">
                                <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                                <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="动作ID"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CopyActionName" Style="{StaticResource MenuButton}" ToolTip="复制动作的名称文字" Margin="0,0,0,3" Click="CopyActionName_Click">
                            <Grid Width="130">
                                <Image Source="/Resources/Images/Quicker1.png" Style="{StaticResource MenuButtonImage}"/>
                                <TextBlock Style="{StaticResource MenuButtonTextBlock}" Text="动作名称"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>