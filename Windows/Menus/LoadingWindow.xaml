<Window
    mc:Ignorable="d"
    x:Class="Quicker.Windows.LoadingWindow"
    xmlns:local="clr-namespace:Quicker.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    
    Width="400"
    Height="150"
    Title="请稍等"
    Topmost="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    
    ContentRendered="LoadingWindow_ContentRendered"
>
    <Grid>
        <Label Content="加载中，请稍等……" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
    </Grid>
</Window>