<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.Menus.SelectActionPageMenu"
    xmlns:local="clr-namespace:Quicker.Windows.Menus"
    mc:Ignorable="d"
        
    WindowStartupLocation="Manual"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Background="{x:Null}"
    WindowStyle="None"
    Topmost="True"
    Height="159"
    Width="200"
    
    Deactivated="SelectActionPageMenu_Deactivated"
>
    <Grid>
        <Border BorderThickness="0" CornerRadius="5" Padding="1" Background="White">
            <StackPanel x:Name="ChangeSceneButtonStackPanel" Margin="-1,-1,-1,-1"/>
        </Border>
    </Grid>
</Window>