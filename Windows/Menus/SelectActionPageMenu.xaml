<Window
    x:Class="Quicker.Windows.Menus.SelectActionPageMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Quicker.Windows.Menus"
    mc:Ignorable="d"
        
    Width="200"
    Height="159"
    Topmost="True"
    WindowStyle="None"
    Background="{x:Null}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    AllowsTransparency="True"
    WindowStartupLocation="Manual"
    
    Deactivated="SelectActionPageMenu_Deactivated"
>
    <Window.Resources>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="White" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEAEAEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="30,0,0,0"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Width" Value="166"/>
        </Style>
        <Style x:Key="Image" TargetType="Image">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Width" Value="166"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="White" BorderThickness="0" CornerRadius="5" Padding="1" Background="White">
            <StackPanel Margin="-1,-1,-1,-1">
                <Button ToolTip="弹出面板窗口" Style="{StaticResource Button}" Margin="0,5,0,0">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/OpenMainWindow1.ico" Style="{StaticResource Image}" Margin="7,0,0,0" Width="16"/>
                        <TextBlock Style="{StaticResource TextBlock}"><Run Language="zh-cn" Text="显示面板窗口"/></TextBlock>
                    </Grid>
                </Button>
                <Button ToolTip="打开设置窗口" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/SettingImage1.ico" Style="{StaticResource Image}" Margin="7,0,0,0" Width="16"/>
                        <TextBlock Style="{StaticResource TextBlock}"><Run Language="zh-cn" Text="设置"/></TextBlock>
                    </Grid>
                </Button>
                <Button ToolTip="打开场景与动作管理窗口" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/ActionPagesManager.ico" Style="{StaticResource Image}"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="场景与动作"/></TextBlock>
                    </Grid>
                </Button>
                <Button ToolTip="暂停和恢复Quicker触发" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Pause.ico" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Width="16" Margin="7,0,7,0"/>
                        <TextBlock x:Name="PauseQuickerTextBlock" Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="暂停"/><LineBreak/><Run Language="zh-cn"/></TextBlock>
                    </Grid>
                </Button>
                <!--<Button Click="Button_Click" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Width="16" Margin="7,0,7,0"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="开启文本悬浮窗"/><LineBreak/><Run Language="zh-cn"/><LineBreak/><Run/></TextBlock>
                    </Grid>
                </Button>
                <Button Click="Button_Click" Style="{StaticResource Button}">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource ToolTip}" Content="录制键盘和鼠标操作并生成动作"/>
                    </Button.ToolTip>
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Width="16" Margin="7,0,7,0"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="键盘录制工具"/><LineBreak/><Run Language="zh-cn"/><LineBreak/><Run/></TextBlock>
                    </Grid>
                </Button>
                <Button Click="Button_Click" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Width="16" Margin="7,0,7,0"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="窗口检查工具"/><LineBreak/><Run/></TextBlock>
                    </Grid>
                </Button>
                <Button Click="Button_Click" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource Image}"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="重新加载键鼠挂钩"/><LineBreak/><Run/></TextBlock>
                    </Grid>
                </Button>
                <Button Click="Button_Click" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource Image}"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="重置键盘状态"/><LineBreak/><Run/></TextBlock>
                    </Grid>
                </Button>
                <Button Click="Button_Click" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/Quicker1.ico" Style="{StaticResource Image}"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="终止动作"/><LineBreak/><Run/></TextBlock>
                    </Grid>
                </Button>-->
                <Button ToolTip="退出并重新启动" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/RestartQuicker.ico" Style="{StaticResource Image}" Margin="7,0,0,0" Width="16"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="重启Quicker"/><LineBreak/><Run Language="zh-cn"/></TextBlock>
                    </Grid>
                </Button>
                <Button ToolTip="关闭Quicker软件" Style="{StaticResource Button}">
                    <Grid>
                        <Image Source="/Resources/Images/Icons/CloseQuicker.ico" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Width="16" Margin="7,0,7,0"/>
                        <TextBlock Height="16" Width="166" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"><Run Language="zh-cn" Text="退出"/><LineBreak/><Run Language="zh-cn"/></TextBlock>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>