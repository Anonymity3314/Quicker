<local:BaseMenuWindow
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.Menus.SelectActionPageMenu"
    xmlns:local="clr-namespace:Quicker.Windows.Menus"
    mc:Ignorable="d"
        
    AllowsTransparency="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Background="{x:Null}"
    WindowStyle="None"
    Topmost="True"
    Height="330"
    Width="650"
>
    <Grid x:Name="MainGrid" Height="10" Width="150" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <!-- 窗口阴影 -->
        <Rectangle Fill="White" Margin="5,7">
            <Rectangle.Effect>
                <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="15" RenderingBias="Quality" ShadowDepth="1"/>
            </Rectangle.Effect>
        </Rectangle>
        <Border BorderThickness="0" CornerRadius="5" Padding="1,6" Background="White">
            <StackPanel x:Name="ChangeSceneButtonStackPanel" Margin="-1,-1,-1,-1"/>
        </Border>
    </Grid>
</local:BaseMenuWindow>