<Window
    mc:Ignorable="d"
    xmlns:local="clr-namespace:Quicker.Windows"
    x:Class="Quicker.Windows.ActionInformationWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    Height="330"
    Width="408"
    Title="动作信息"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
>
    <Window.Resources>
        <Style x:Key="Close" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#FF326CF3" BorderBrush="#FFF3F3F3" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4C7EF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Copy" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="#FFD5D5D5" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F3F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Label Content="ID" HorizontalAlignment="Left" Margin="99,21,0,0" VerticalAlignment="Top"/>
        <Label Content="标题" HorizontalAlignment="Left" Margin="88,46,0,0" VerticalAlignment="Top"/>
        <Label Content="说明" HorizontalAlignment="Left" Margin="88,71,0,0" VerticalAlignment="Top"/>
        <Label Content="图标" HorizontalAlignment="Left" Margin="88,97,0,0" VerticalAlignment="Top"/>
        <Label Content="创建时间" HorizontalAlignment="Left" Margin="64,147,0,0" VerticalAlignment="Top"/>
        <Rectangle HorizontalAlignment="Center" Height="1" Margin="0,224,0,0" Fill="#E8E8E8" VerticalAlignment="Top" Width="392"/>
        <Image x:Name="Image" HorizontalAlignment="Left" Height="48" Margin="127,97,0,0" VerticalAlignment="Top" Width="48"/>
        <Label x:Name="IDLabel" Content="Label" HorizontalAlignment="Left" Margin="122,21,0,0" VerticalAlignment="Top"/>
        <Label x:Name="TitleLabel" Content="Label" HorizontalAlignment="Left" Margin="122,46,0,0" VerticalAlignment="Top"/>
        <Label HorizontalAlignment="Left" Margin="122,71,0,0" VerticalAlignment="Top"/>
        <Label x:Name="UsageLabel" Content="Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="122,71,0,0"/>
        <Label x:Name="CreatTimeLabel" Content="Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="122,147,0,0"/>
        <Label Content="最后编辑" HorizontalAlignment="Left" Margin="64,172,0,0" VerticalAlignment="Top"/>
        <Label x:Name="LatestEditTimeLabel" Content="Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="122,172,0,0"/>
        <Button x:Name="CloseButton" Style="{StaticResource Close}" Content="关闭" HorizontalAlignment="Left" Margin="327,234,0,0" VerticalAlignment="Top" Width="47" Foreground="White" Height="30" Click="CloseButton_Click"/>
        <Button x:Name="CopyButton" Style="{StaticResource Copy}" Content="复制基本信息" HorizontalAlignment="Left" Margin="223,234,0,0" VerticalAlignment="Top" Width="94" Height="30" Click="CopyButton_Click"/>
    </Grid>
</Window>